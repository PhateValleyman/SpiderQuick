{
	"format_version": "1.10.0",
	"minecraft:client_entity": {
		"description": {
			"identifier": "spidermanaddon:pumpkin_knife_guide_explosive_shoot",
			"materials": {
				"default": "entity_emissive_alpha"
			},
			"textures": {
				"default": "textures/3d_items/pumpkin_knife_guide_explosive"
			},
			"geometry": {
				"default": "geometry.pumpkin_knife_guide"
			},
			"render_controllers": [
				"controller.render.default"
			],
			"animations": {
				"move": "animation.bullet.move"
			},
			"scripts": {
				"pre_animation": [
					"variable.shake = query.shake_time - query.frame_alpha;",
					"variable.shake_power = variable.shake > 0.0 ? -Math.sin(variable.shake * 200.0) * variable.shake : 0.0;"
				],
				"animate": [
					"move"
				]
			}
		}
	}
}