{
	"format_version": "1.16.100",
	"minecraft:attachable": {
		"description": {
			"identifier": "spidermanaddon:spider_rush",
			"materials": {
				"default": "entity_emissive_alpha"
			},
			"textures": {
				"default": "textures/suits/metal_arms",
				"iron_spider": "textures/suits/iron_arms",
				"iron_spider_comic": "textures/suits/iron_spider_metal_arms",
				"superior_spiderman": "textures/suits/superior_spiderman_iron_arms",
				"superior_spiderman_1": "textures/suits/superior_spiderman_1_iron_arms",
				"superior_spiderman_3": "textures/suits/superior_spiderman_3_iron_arms",
				"noir_iron_arms": "textures/suits/noir_iron_arms",
				"enchanted": "textures/misc/enchanted_item_glint"
			},
			"geometry": {
				"default": "geometry.iron_arms"
			},
			"scripts": {
				"pre_animation": [
					"v.main_hand = c.item_slot == 'main_hand';",
					"v.off_hand = c.item_slot == 'off_hand';"
				],
                "animate": [
                    "iron_arms.idle",
					"iron_arms.first",
					"skill.c",
					"iron_arms.c"
                ]
			},
			"render_controllers": [
				{ "controller.render.armor": "c.is_first_person && !q.equipped_item_any_tag('slot.armor.head', 'venom') && !q.equipped_item_any_tag('slot.armor.feet', 'special_metal_arms')" },
				{ "controller.render.iron_arms.iron_spider": "c.is_first_person && !q.equipped_item_any_tag('slot.armor.head', 'convert_entity') && q.equipped_item_any_tag('slot.armor.feet', 'iron_spider_ucm_suit')" },
				{ "controller.render.iron_arms.iron_spider_comic": "c.is_first_person && !q.equipped_item_any_tag('slot.armor.head', 'convert_entity') && q.equipped_item_any_tag('slot.armor.feet', 'iron_spider')" },
				{ "controller.render.iron_arms.superior_spiderman": "c.is_first_person && !q.equipped_item_any_tag('slot.armor.head', 'convert_entity') && (q.equipped_item_any_tag('slot.armor.feet', 'superior_spiderman_suit') || q.equipped_item_any_tag('slot.armor.feet', 'superior_spiderman_suit_2'))" },
				{ "controller.render.iron_arms.superior_spiderman.1": "c.is_first_person && !q.equipped_item_any_tag('slot.armor.head', 'convert_entity') && q.equipped_item_any_tag('slot.armor.feet', 'superior_spiderman_suit_1')" },
				{ "controller.render.iron_arms.superior_spiderman.3": "c.is_first_person && !q.equipped_item_any_tag('slot.armor.head', 'convert_entity') && q.equipped_item_any_tag('slot.armor.feet', 'superior_spiderman_suit_3')" },
				{ "controller.render.iron_arms.noir_iron_arms": "c.is_first_person && !q.equipped_item_any_tag('slot.armor.head', 'convert_entity') && q.equipped_item_any_tag('slot.armor.feet', 'noir_suit')" }
			],
            "animations": {
				"skill.c": "controller.animation.spiderman.iron_arms.skill",
				"spider_shock": "animation.iron_arms.spider_shock",
				"spider_rush": "animation.iron_arms.spider_rush",
				"iron_arms.first": "animation.iron_arms.first",
				"iron_arms.c": "controller.animation.spiderman.iron_arms",
				"iron_arms.idle": "animation.iron_arms.idle",
				"iron_arms.attack": "animation.iron_arms.attack",
				"iron_arms.attack.2": "animation.iron_arms.attack.2",
				"iron_arms.attack.3": "animation.iron_arms.attack.3",
				"iron_arms.attack.4": "animation.iron_arms.attack.4"
            }
		}
	}
}