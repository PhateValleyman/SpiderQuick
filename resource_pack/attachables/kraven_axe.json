			"identifier": "spidermanaddon:kraven_axe",
			"materials": {
				"default": "entity_emissive_alpha"
			},
			"textures": {
				"default": "textures/items_3d/kraven_axe"
			},
			"geometry": {
				"default": "geometry.kraven_axe"
			},
			"render_controllers": [
				"controller.render.default"
			],
			"animations": {
				"first_person_main_hand": "animation.kraven_axe.first"
			},
			"scripts": {
