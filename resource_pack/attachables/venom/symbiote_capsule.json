{
	"format_version": "1.16.100",
	"minecraft:attachable": {
		"description": {
			"identifier": "spidermanaddon:symbiote_capsule",
			"materials": {
				"default": "entity_emissive_alpha"
			},
			"textures": {
				"default": "textures/entity/symbiote_capsule/symbiote_capsule.png"
			},
			"geometry": {
				"default": "geometry.symbiote_capsule"
			},
			"render_controllers": [
				"controller.render.default"
			],
			"animations": {
				"first_person_main_hand": "animation.symbiote_capsule.first",
				"third_person_main_hand": "animation.symbiote_capsule.third",
				"loop": "animation.symbiote_capsule.loop"
			},
			"scripts": {
				"pre_animation": [
					"v.main_hand = c.item_slot == 'main_hand';"
				],
				"animate": [
					{
						"first_person_main_hand": "(v.main_hand && c.is_first_person)"
					},
					{
						"third_person_main_hand": "(v.main_hand && !c.is_first_person)"
					},
					{
						"loop": "(v.main_hand)"
					}
				]
			}
		}
	}
}