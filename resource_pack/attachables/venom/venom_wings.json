				"idle.c": "animation.venom.idle",
				"wings.c": "controller.animation.venom.wings",
                "wings.fly": "animation.venom.wings.fly",
				"wings.off": "animation.venom.wings.off",
				"wings.active": "animation.venom.wings.active",
                "wings.on": "animation.venom.wings.on",
				"wings.apagar": "animation.venom.wings.apagar",
				"symb.off": "animation.venom.wing.symb.off"
            }
		}
	}
}