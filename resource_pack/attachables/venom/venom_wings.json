{
	"format_version": "1.16.100",
	"minecraft:attachable": {
		"description": {
			"identifier": "marveladdons:venom_wings",
			"materials": {
				"default": "slime"
			},
			"textures": {
				"default": "textures/entity/venom/venom"
			},
			"geometry": {
				"default": "geometry.venom_wings"
			},
			"render_controllers": [
				{ "controller.render.default": "!q.equipped_item_any_tag('slot.armor.legs', 'venom_powers')" }
			],
