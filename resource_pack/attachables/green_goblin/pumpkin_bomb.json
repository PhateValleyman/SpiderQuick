{
	"format_version": "1.16.100",
	"minecraft:attachable": {
		"description": {
			"identifier": "spidermanaddon:pumpkin_bomb",
			"materials": {
				"default": "entity_emissive_alpha"
			},
			"textures": {
				"default": "textures/entity/green_goblin/green_goblin.png"
			},
			"geometry": {
				"default": "geometry.pumpkin_bomb_item"
			},
			"render_controllers": [
				"controller.render.default"
			],
			"animations": {
				"first_person_main_hand": "animation.green_goblin.pumpkin_item",
				"third_person_main_hand": "animation.green_goblin.pumpkin_item_3"
			},
			"scripts": {
				"pre_animation": [
					"v.main_hand = c.item_slot == 'main_hand';"
				],
				"animate": [
					{
						"first_person_main_hand": "(v.main_hand && !c.is_first_person)"
					},
					{
						"third_person_main_hand": "(v.main_hand && c.is_first_person)"
					}
				]
			}
		}
	}
}