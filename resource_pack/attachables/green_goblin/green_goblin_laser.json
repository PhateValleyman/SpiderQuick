{
	"format_version": "1.10.0",
	"minecraft:attachable": {
		"description": { 
			"identifier": "spidermanaddon:green_goblin_laser",
			"materials": {
				"default": "entity_emissive_alpha"
			},
			"textures": {
				"default": "textures/entity/green_goblin/green_goblin",
				"hobgoblin": "textures/entity/green_goblin/hobgoblin"
			},
			"geometry": {
				"default": "geometry.green_goblin_laser_third",
				"first": "geometry.green_goblin_laser_first"
			},
			"render_controllers": [
				{ "controller.render.item_3d": "!c.is_first_person && !q.equipped_item_any_tag('slot.armor.feet', 'hobgoblin_suit')" },
				{ "controller.render.item_3d.first": "c.is_first_person && !q.equipped_item_any_tag('slot.armor.feet', 'hobgoblin_suit')" },
				{ "controller.render.hobgoblin_laser": "!c.is_first_person && q.equipped_item_any_tag('slot.armor.feet', 'hobgoblin_suit')" },
				{ "controller.render.hobgoblin_laser.first": "c.is_first_person && q.equipped_item_any_tag('slot.armor.feet', 'hobgoblin_suit')" }
			],
			"scripts": {
				"pre_animation": [
					"v.main_hand = c.item_slot == 'main_hand';",
					"v.off_hand = c.item_slot == 'off_hand';"
				],
                "animate": [
					{ "laser": "q.property('arathnido:animation') == 2" }
                ]
			},
            "animations": {
				"laser": "animation.green_goblin.laser.shoot"
            }
		}
	}
}
