{
	"format_version": "1.10.0",
	"minecraft:attachable": {
		"description": { 
			"identifier": "spiderverse:spider_carnage_suit.armor_stand",
			"item": {
				"spiderverse:spider_carnage_suit": "query.owner_identifier == 'minecraft:armor_stand'"
			},
			"materials": {
				"default": "armor",
				"enchanted": "armor_enchanted",
				"armor_skin": "slime"
			},
			"textures": {
				"default": "textures/suits/spider_carnage",
				"enchanted": "textures/misc/enchanted_item_glint"
			},
			"geometry": {
				"default": "geometry.spider_carnage"
			},
			"scripts": {
                "animate": [
					"idle"
                ]
			},
            "animations": {
				"idle": "animation.venom_s3.idle"
            },
			"render_controllers": [
				{ "controller.render.armor": "!q.equipped_item_any_tag('slot.armor.head', 'convert_entity')" }
			]
		}
	}
}
