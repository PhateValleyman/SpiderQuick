{
	"format_version": "1.10.0",
	"minecraft:attachable": {
		"description": { 
			"identifier": "spiderverse:silk_suit.armor_stand",
			"item": {
				"spiderverse:silk_suit": "query.owner_identifier == 'minecraft:armor_stand'"
			},
			"materials": {
				"default": "armor",
				"outline": "armor"
			},
			"textures": {
				"default": "textures/suits/silk",
				"outline": "textures/suits/silk"
			},
			"geometry": {
				"default": "geometry.silk_suit",
				"outline": "geometry.silk_mask"
			},
			"render_controllers": [
				"controller.render.default",
				"controller.render.outline"
			]
		}
	}
}