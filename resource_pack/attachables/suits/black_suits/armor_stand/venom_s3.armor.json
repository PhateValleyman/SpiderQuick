{
	"format_version": "1.10.0",
	"minecraft:attachable": {
		"description": { 
			"identifier": "spiderverse:venom_s3.armor_stand",
			"item": {
				"spiderverse:venom_s3": "query.owner_identifier == 'minecraft:armor_stand'"
			},
			"materials": {
				"default": "armor",
				"enchanted": "armor_enchanted",
				"armor_skin": "slime"
			},
			"textures": {
				"default": "textures/entity/venom/venom_s3",
				"enchanted": "textures/misc/enchanted_item_glint",
				"armor_skin": "textures/entity/invisible",
				"web_wings": "textures/web_wings"
			},
			"geometry": {
				"default": "geometry.venom_s3",
				"armor_skin": "geometry.player_ironman",
				"web_wings": "geometry.web_wings"
			},
			"scripts": {
                "animate": [
					"idle"
                ]
			},
            "animations": {
				"idle": "animation.venom_s3.idle"
            },
			"render_controllers": [
				{ "controller.render.spiderman_suit.web_wings": "q.is_gliding && !q.equipped_item_any_tag('slot.armor.head', 'convert_entity')" },
				{ "controller.render.armor": "!q.equipped_item_any_tag('slot.armor.head', 'convert_entity')" },
				{ "controller.render.armor_skin": "q.equipped_item_any_tag('slot.armor.head', 'convert_entity')" }
			]
		}
	}
}
