{
  "format_version": "1.10.0",
  "minecraft:attachable": {
    "description": {
      "identifier": "spiderverse:spiderman_rivals_suit",
      "materials": {
        "default": "armor",
        "enchanted": "armor_enchanted",
		"outline": "outline"
      },
      "textures": {
        "default": "textures/suits/spiderman_rivals_suit",
        "enchanted": "textures/misc/enchanted_item_glint",
		"outline": "textures/suits/spiderman_outline",
        "web_wings": "textures/web_wings"
      },
      "geometry": {
        "default": "geometry.spiderman_suit_x64",
        "web_wings": "geometry.web_wings",
		"outline": "geometry.spiderman_rivals_suit_outline"
      },
      "render_controllers": [
        {
          "controller.render.spiderman_suit.web_wings": "q.is_gliding && !q.equipped_item_any_tag('slot.armor.head', 'convert_entity')"
        },
        {
          "controller.render.armor": "!q.equipped_item_any_tag('slot.armor.head', 'convert_entity')"
        },
		{ "controller.render.outline": "!q.equipped_item_any_tag('slot.armor.head', 'convert_entity')" }
      ]
    }
  }
}