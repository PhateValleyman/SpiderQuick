{
	"format_version": "1.10.0",
	"minecraft:attachable": {
		"description": { 
			"identifier": "spiderverse:iron_spider_ucm_mask",
			"materials": {
				"default": "entity_emissive_alpha",
				"enchanted": "armor_enchanted",
				"armor_skin": "slime"
			},
			"textures": {
				"default": "textures/suits/iron_spider_ucm_suit",
				"iron_spider_ucm_suit_0": "textures/suits/iron_spider_ucm_transform/iron_spider_ucm_suit_0",
				"iron_spider_ucm_suit_1": "textures/suits/iron_spider_ucm_transform/iron_spider_ucm_suit_1",
				"iron_spider_ucm_suit_2": "textures/suits/iron_spider_ucm_transform/iron_spider_ucm_suit_2",
				"iron_spider_ucm_suit_3": "textures/suits/iron_spider_ucm_transform/iron_spider_ucm_suit_3",
				"killer_mode": "textures/suits/iron_spider_ucm_killer_mode",
				"enchanted": "textures/misc/enchanted_item_glint",
				"armor_skin": "textures/entity/invisible"
			},
			"geometry": {
				"default": "geometry.spiderman_mask_x64",
				"armor_skin": "geometry.player_ironman"
			},
			"scripts": {
                "animate": [
                    "default_c",
					"mask_c",
					"selfie_hand_c",
					"iron_spider_mask_c",
					"iron_spider_off"
                ]
			},
			"render_controllers": [
				{ "controller.render.armor": "((q.property('arathnido:SuitTexture0') == 5 && q.equipped_item_any_tag('slot.armor.feet', 'iron_spider_ucm_suit')) || !q.equipped_item_any_tag('slot.armor.feet', 'iron_spider_ucm_suit')) && !q.equipped_item_any_tag('slot.armor.head', 'convert_entity') && !q.equipped_item_any_tag('slot.weapon.mainhand', 'iron_arms_item')" },
				{ "controller.render.iron_spider_ucm.killer_mode": "!q.equipped_item_any_tag('slot.armor.head', 'convert_entity') && q.equipped_item_any_tag('slot.weapon.mainhand', 'iron_arms_item')" },
				{ "controller.render.iron_spider_ucm.transform.0": "q.property('arathnido:SuitTexture0') == 1 && !q.equipped_item_any_tag('slot.armor.head', 'convert_entity')" },
				{ "controller.render.iron_spider_ucm.transform.1": "q.property('arathnido:SuitTexture0') == 2 && !q.equipped_item_any_tag('slot.armor.head', 'convert_entity')" },
				{ "controller.render.iron_spider_ucm.transform.2": "q.property('arathnido:SuitTexture0') == 3 && !q.equipped_item_any_tag('slot.armor.head', 'convert_entity')" },
				{ "controller.render.iron_spider_ucm.transform.3": "q.property('arathnido:SuitTexture0') == 4 && !q.equipped_item_any_tag('slot.armor.head', 'convert_entity')" },
				{ "controller.render.armor_skin": "q.equipped_item_any_tag('slot.armor.head', 'convert_entity')" }
			],
            "animations": {
				"iron_spider_off": "animation.iron_spider.suit.off",
                "iron_spider_mask_c": "controller.animation.iron_spider.mask",
				"iron_spider.normal": "animation.iron_spider_ucm_suit.normal",
                "iron_spider.killer_mode": "animation.iron_spider_ucm_suit.killer",
				
                "mask_c": "controller.animation.suit.mask",
                "mask.off": "animation.mask.on",
				"mask.on": "animation.mask.off",
				"mask.time": "animation.spider_female.mask_time",
				
                "default_c": "controller.animation.spiderman_suit.web_default",
                "web_off": "animation.spiderman.web_shooters.off",
				"web_on": "animation.spiderman.web_shooters.on",
				"selfie_hand_c": "controller.animation.spiderman_suit.selfie_hand",
				"selfie_hand": "animation.spiderman.web_shooters.selfie_hand"
            }
		}
	}
}
