{
	"format_version": "1.10.0",
	"minecraft:attachable": {
		"description": { 
			"identifier": "spiderverse:spiderman_unlimited_mask",
			"materials": {
				"default": "entity_emissive_alpha",
				"enchanted": "armor_enchanted",
				"armor_skin": "slime",
				"outline": "outline",
				"outline_color": "outline"
			},
			"textures": {
				"default": "textures/suits/spiderman_unlimited_suit",
				"iron_spider_ucm_suit_0": "textures/suits/spiderman_unlimited_transform/spiderman_unlimited_suit_0",
				"iron_spider_ucm_suit_1": "textures/suits/spiderman_unlimited_transform/spiderman_unlimited_suit_1",
				"iron_spider_ucm_suit_2": "textures/suits/spiderman_unlimited_transform/spiderman_unlimited_suit_2",
				"iron_spider_ucm_suit_3": "textures/suits/spiderman_unlimited_transform/spiderman_unlimited_suit_3",
				"enchanted": "textures/misc/enchanted_item_glint",
				"armor_skin": "textures/entity/invisible",
				"outline_color": "textures/suits/spiderman_90_blue",
				"outline": "textures/suits/spiderman_outline"
			},
			"geometry": {
				"default": "geometry.spiderman_unlimited_mask_x64",
				"armor_skin": "geometry.player_ironman",
				"outline": "geometry.spiderman_mask_x64_outline",
				"outline_color": "geometry.spiderman_mask_x64_outline_color"
			},
			"scripts": {
                "animate": [
                    "default_c",
					"mask_c",
					"selfie_hand_c"
                ]
			},
			"render_controllers": [
				{ "controller.render.armor": "((q.property('arathnido:SuitTexture0') == 5 && q.equipped_item_any_tag('slot.armor.feet', 'spiderman_unlimited_suit')) || !q.equipped_item_any_tag('slot.armor.feet', 'spiderman_unlimited_suit')) && !q.equipped_item_any_tag('slot.armor.head', 'convert_entity')" },
				{ "controller.render.iron_spider_ucm.transform.0": "q.property('arathnido:SuitTexture0') == 1 && !q.equipped_item_any_tag('slot.armor.head', 'convert_entity')" },
				{ "controller.render.iron_spider_ucm.transform.1": "q.property('arathnido:SuitTexture0') == 2 && !q.equipped_item_any_tag('slot.armor.head', 'convert_entity')" },
				{ "controller.render.iron_spider_ucm.transform.2": "q.property('arathnido:SuitTexture0') == 3 && !q.equipped_item_any_tag('slot.armor.head', 'convert_entity')" },
				{ "controller.render.iron_spider_ucm.transform.3": "q.property('arathnido:SuitTexture0') == 4 && !q.equipped_item_any_tag('slot.armor.head', 'convert_entity')" },
				{ "controller.render.armor_skin": "q.equipped_item_any_tag('slot.armor.head', 'convert_entity')" },
				{ "controller.render.outline_color": "!query.equipped_item_any_tag('slot.armor.head', 'convert_entity')" },
				{ "controller.render.outline": "!q.equipped_item_any_tag('slot.armor.head', 'convert_entity')" }
			],
            "animations": {
                "mask_c": "controller.animation.suit.mask",
                "mask.off": "animation.mask.on",
				"mask.on": "animation.mask.off",
				"mask.time": "animation.spider_female.mask_time",
				
                "default_c": "controller.animation.spiderman_suit.web_default",
                "web_off": "animation.spiderman.web_shooters.off",
				"web_on": "animation.spiderman.web_shooters.on",
				"selfie_hand_c": "controller.animation.spiderman_suit.selfie_hand",
				"selfie_hand": "animation.spiderman.web_shooters.selfie_hand"
            }
		}
	}
}
