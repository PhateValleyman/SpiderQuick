{
	"format_version": "1.10.0",
	"minecraft:attachable": {
		"description": { 
			"identifier": "minecraft:chainmail_leggings.player",
			"item": {
				"minecraft:chainmail_leggings": "query.owner_identifier == 'minecraft:player'"
			},
			"materials": {
				"default": "armor",
				"enchanted": "armor_enchanted",
				"armor_skin": "slime"
			},
			"textures": {
				"default": "textures/models/armor/chain_2",
				"enchanted": "textures/misc/enchanted_item_glint",
				"armor_skin": "textures/entity/invisible"
			},
			"geometry": {
				"default": "geometry.player.armor.leggings",
				"armor_skin": "geometry.player_ironman"
			},
			"scripts": {
				"parent_setup": "variable.boot_layer_visible = 0.0;"
			},
			"render_controllers": [
				{ "controller.render.armor": "!query.equipped_item_any_tag('slot.armor.head', 'convert_entity')" },
				{ "controller.render.armor_skin": "query.equipped_item_any_tag('slot.armor.head', 'convert_entity')" }
			]
		}
	}
}
