{
	"format_version" : "1.10.0",
	"animation_controllers" : {
		"controller.animation.planeador" : {
			"initial_state" : "default",
			"states" : {
				"default" : {
					"animations" : [ "off" ],
					"transitions" : [
						{
							"planeador" : "!q.is_on_ground"
						}
					],
					"blend_transition": 0.25
				},
				"planeador" : {
					"animations" : [ "planeador" ],
					"transitions" : [
						{
							"default" : "q.is_on_ground"
						}
					],
					"blend_transition": 0.25
				}
			}
		}
	}
}