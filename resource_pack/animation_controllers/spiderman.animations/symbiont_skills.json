{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.player.symbiont": {
      "initial_state": "default",
      "states": {
        "default": {
          "animations": [
            "player.agent_venom.blast.c",
            "player.symbiont.cellular_corrosion.c",
            "player.symbiont.symbiont_pull.c",
            "player.symbiont.symbiote_strike.c",
            "player.symbiont.antivenom_bomb.c",
            "player.symbiont.antivenom_tempest.c",
            {
              "player.symbiont.venom_rage.c": "!v.is_first_person"
            },
            {
              "player.symbiont.combat.c": "!v.is_first_person"
            },
            {
              "player.venom.first.c": "q.equipped_item_any_tag('slot.armor.head', 'venom_transform') && v.is_first_person"
            },
            {
              "player.venom.first": "q.equipped_item_any_tag('slot.weapon.mainhand', 'venom_knife_whip') && !q.equipped_item_any_tag('slot.armor.head', 'venom_transform') && v.is_first_person"
            },
            {
              "player.agent_venom_fusil.first": "q.equipped_item_any_tag('slot.weapon.mainhand', 'agent_venom_fusil') && v.is_first_person"
            },
            {
              "player.agent_venom_pistol.third": "q.equipped_item_any_tag('slot.weapon.mainhand', 'agent_venom_fusil') && !v.is_first_person"
            },
            {
              "player.agent_venom_fusil.third": "q.equipped_item_any_tag('slot.weapon.mainhand', 'agent_venom_pistols') && !v.is_first_person"
            },
            "player.agent_venom.fusil.c",
            "player.agent_venom.pistols.c",
            {
              "player.spirit_spider_head.idle": "q.equipped_item_any_tag('slot.armor.head', 'spiderman_special_mask') && !v.is_first_person"
            },
            {
              "player.spirit_spider_head.fire": "q.equipped_item_any_tag('slot.armor.head', 'spirit_spider_mask') && !v.is_first_person"
            },
            "player.symbiont.evil_dance.c"
          ]
        }
      }
    },
    "controller.animation.player.symbiont.evil_dance": {
      "initial_state": "default",
      "states": {
        "default": {
          "transitions": [
            {
              "on": "q.equipped_item_any_tag('slot.weapon.mainhand', 'venom_item') && q.property('arathnido:animation') == 26"
            }
          ]
        },
        "on": {
          "animations": [
            "player.symbiont.dance.on"
          ],
          "transitions": [
            {
              "default": "q.ground_speed > 0.1 || !q.is_on_ground || q.is_in_water || q.is_gliding || q.is_sneaking || q.is_sprinting"
            },
            {
              "dance": "q.all_animations_finished"
            }
          ]
        },
        "dance": {
          "animations": [
            "player.symbiont.dance"
          ],
          "transitions": [
            {
              "default": "q.ground_speed > 0.1 || !q.is_on_ground || q.is_in_water || q.is_gliding || q.is_sneaking || q.is_sprinting"
            }
          ],
          "blend_transition": 0.25
        }
      }
    },
    "controller.animation.player.agent_venom.fusil": {
      "initial_state": "default",
      "states": {
        "default": {
          "transitions": [
            {
              "shoot": "q.equipped_item_any_tag('slot.weapon.mainhand', 'agent_venom_fusil') && q.property('arathnido:animation') == 2"
            },
            {
              "reload": "q.equipped_item_any_tag('slot.weapon.mainhand', 'agent_venom_fusil') && q.property('arathnido:animation') == 3"
            }
          ]
        },
        "shoot": {
          "animations": [
            {
              "player.agent_venom.fusil.shoot.third": "!v.is_first_person"
            },
            {
              "player.agent_venom.fusil.shoot.first": "v.is_first_person"
            }
          ],
          "transitions": [
            {
              "default": "(!q.equipped_item_any_tag('slot.weapon.mainhand', 'agent_venom_fusil') || q.property('arathnido:animation') == 0) && q.any_animation_finished"
            },
            {
              "reload": "q.equipped_item_any_tag('slot.weapon.mainhand', 'agent_venom_fusil') && q.property('arathnido:animation') == 3"
            }
          ]
        },
        "reload": {
          "animations": [
            {
              "player.agent_venom.fusil.reload.third": "!v.is_first_person"
            },
            {
              "player.agent_venom.fusil.reload.first": "v.is_first_person"
            }
          ],
          "transitions": [
            {
              "shoot": "q.equipped_item_any_tag('slot.weapon.mainhand', 'agent_venom_fusil') && q.property('arathnido:animation') == 2"
            },
            {
              "default": "(!q.equipped_item_any_tag('slot.weapon.mainhand', 'agent_venom_fusil') || q.property('arathnido:animation') == 0) && q.any_animation_finished"
            }
          ]
        }
