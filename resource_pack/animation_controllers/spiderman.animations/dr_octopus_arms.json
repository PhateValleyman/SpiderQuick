						{ "dr_octopus.take.offhand" : "q.equipped_item_any_tag('slot.weapon.offhand', 'dr_octopus_walk') && q.equipped_item_any_tag('slot.weapon.mainhand', 'dr_octopus_take') && q.property('arathnido:animation') == 5" }
					]
				},
