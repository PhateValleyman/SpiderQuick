{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.customer.state": {
      "initial_state": "default",
      "states": {
        "default": {
          "animations": [
            "default"
          ],
          "transitions": [
            {
              "end": "query.property('spidermanaddon:state') == 'end'"
            }
          ]
        },
        "end": {
          "animations": [
            "end"
          ],
          "transitions": [
            {
              "default": "query.property('spidermanaddon:state') == 'default'"
            }
          ]
        }
      }
    }
  }
}
