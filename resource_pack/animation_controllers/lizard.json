{
	"format_version" : "1.10.0",
	"animation_controllers" : {
		"controller.animation.lizard.suit" : {
			"initial_state" : "default",
			"states" : {
				"default" : {
					"transitions" : [
						{
							"lizard.suit" : "q.variant == 1"
						}
					]
				},
				"lizard.suit" : {
					"animations" : [ "suit" ],
					"transitions" : [
						{
							"default" : "q.variant == 0"
						}
					]
				}
			}
		},
		"controller.animation.lizard.walk" : {
			"initial_state" : "default",
			"states" : {
				"default" : {
					"transitions" : [
						{
							"lizard.walk" : "q.modified_move_speed > 0.1 && q.mark_variant == 0"
						}
					]
				},
				"lizard.walk" : {
					"animations" : [ "walk" ],
					"transitions" : [
						{
							"default" : "q.modified_move_speed < 0.1 || q.mark_variant == 1 || q.mark_variant == 2 || q.mark_variant == 3"
						}
					]
				}
			}
		},
		"controller.animation.lizard.hability" : {
			"initial_state" : "default",
			"states" : {
				"default" : {
					"transitions" : [
						{
							"roar" : "q.mark_variant == 1"
						},
						{
							"jump" : "q.mark_variant == 2"
						}
					]
				},
				"roar" : {
					"animations" : [ "roar" ],
					"transitions" : [
						{
							"default" : "q.mark_variant == 0 && q.all_animations_finished"
						}
					]
				},
				"jump" : {
					"animations" : [ "jump" ],
					"transitions" : [
						{
							"jump_on" : "q.mark_variant == 3 && q.all_animations_finished"
						}
					]
				},
				"jump_on" : {
					"animations" : [ "jump_on" ],
					"transitions" : [
						{
							"attack.2" : "q.is_on_ground && q.all_animations_finished"
						}
					]
				},
				"attack.2" : {
					"animations" : [ "attack.2" ],
					"transitions" : [
						{
							"default" : "q.all_animations_finished"
						}
					]
				}
			}
		},
		"controller.animation.lizard.attack" : {
			"initial_state" : "default",
			"states" : {
				"default" : {
					"transitions" : [
						{
							"attack" : "variable.attack>0 && q.mark_variant == 0"
						}
					]
				},
				"attack" : {
					"animations" : [ "attack" ],
					"transitions" : [
						{
							"attack.2" : "q.all_animations_finished && variable.attack>0"
						}
					]
				},
				"attack.2" : {
					"animations" : [ "attack.2" ],
					"transitions" : [
						{
							"default" : "q.all_animations_finished"
						}
					]
				}
			}
		}
	}
}