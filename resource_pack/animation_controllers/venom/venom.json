		"controller.animation.venom.take" : {
			"initial_state" : "default",
			"states" : {
				"default" : {
					"transitions" : [
						{
							"idle" : "q.property('arathnido:take') == true"
						}
					]
				},
				"idle" : {
					"animations" : [ "attack.1", { "take": "q.any_animation_finished" } ],
					"transitions" : [
						{
							"loop" : "q.any_animation_finished && !q.is_using_item"
						}
					]
				},
				"loop" : {
					"animations" : [ "take" ],
					"transitions" : [
						{ "take.final_attack" : "q.is_using_item" },
						{ "take.shoot" : "q.property('arathnido:attack') == true" }
					]
				},
				"take.final_attack" : {
					"animations" : [ "take.smash" ],
					"transitions" : [
