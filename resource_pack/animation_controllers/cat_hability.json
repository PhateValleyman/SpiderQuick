{
	"format_version" : "1.10.0",
	"animation_controllers" : {
		"controller.animation.cat_hability.sit" : {
			"initial_state" : "default",
			"states" : {
				"default" : {
					"transitions" : [
						{
							"cat_hability.sit" : "q.is_sitting"
						}
					]
				},
				"cat_hability.sit" : {
					"animations" : [ "sit" ],
					"transitions" : [
						{
							"default" : "!q.is_sitting"
						}
					]
				}
			}
		},
		"controller.animation.cat_hability.win" : {
			"initial_state" : "default",
			"states" : {
				"default" : {
					"transitions" : [
						{
							"cat_hability.win" : "q.is_celebrating"
						}
					]
				},
				"cat_hability.win" : {
					"animations" : [ "win" ],
					"transitions" : [
						{
							"default" : "!q.is_celebrating && q.any_animation_finished"
						}
					]
				}
			}
		},
		"controller.animation.cat_hability.walk" : {
			"initial_state" : "default",
			"states" : {
				"default" : {
					"transitions" : [
						{
							"cat_hability.walk" : "q.modified_move_speed > 0.1"
						}
					]
				},
				"cat_hability.walk" : {
					"animations" : [ "walk" ],
					"transitions" : [
						{
							"default" : "q.modified_move_speed < 0.1"
						}
					]
				}
			}
		},
		"controller.animation.cat_hability.attack" : {
			"initial_state" : "default",
			"states" : {
				"default" : {
					"transitions" : [
						{
							"attack" : "variable.attack>0"
						}
					]
				},
				"attack" : {
					"animations" : [ "attack" ],
					"transitions" : [
						{
							"default" : "q.all_animations_finished"
						}
					]
				}
			}
		}
	}
}