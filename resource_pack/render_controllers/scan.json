{
  "format_version": "1.8.0",
	"render_controllers": {
		"controller.render.scan_icon": {
		  "arrays": {
			"textures": {
			  "Array.skins": [
				"Texture.pasive", 
				"Texture.enemy", 
				"Texture.player"
			  ]
			}
		  },
		  "geometry": "Geometry.default",
		  "materials": [ { "*": "Material.default" } ],
		  "part_visibility": [
			{ "*": "q.is_alive" }
		  ],
		  "textures": [ "Array.skins[query.variant]" ]
		},
		"controller.render.scan": {
		  "geometry": "Geometry.scan",
		  "materials": [ { "*": "Material.scan" } ],
		  "part_visibility": [
			{ "*": "q.property('nido:scan') == false && q.is_alive" }
		  ],
		  "textures": [ "Texture.scan" ]
		}
  }
}