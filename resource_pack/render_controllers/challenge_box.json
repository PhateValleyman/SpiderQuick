{
  "format_version": "1.8.0",
  "render_controllers": {
    "controller.render.challenge_box": {
      "geometry": "Geometry.default",
      "materials": [ { "*": "variable.is_enchanted ? Material.enchanted : Material.default" } ],
      "part_visibility": [
        { "*": "q.variant == 0 || q.variant == 1 || q.variant == 3 || q.variant == 5" }
      ],
      "textures": [ "Texture.default" ]
    },
    "controller.render.challenge_box.bomb": {
      "geometry": "Geometry.bomb",
      "materials": [ { "*": "variable.is_enchanted ? Material.enchanted : Material.default" } ],
      "part_visibility": [
        { "*": "q.variant == 2" }
      ],
      "textures": [ "Texture.bomb" ]
    },
    "controller.render.challenge_box.villager": {
      "geometry": "Geometry.villager",
      "materials": [ { "*": "variable.is_enchanted ? Material.enchanted : Material.default" } ],
      "part_visibility": [
        { "*": "q.variant == 4" }
      ],
      "textures": [ "Texture.villager" ]
    }
  }
}