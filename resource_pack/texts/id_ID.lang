dialog.punisher.interact.low.1=§8Punisher:§r Jangan salah mengira kerja sama sebagai persahabatan.
dialog.punisher.interact.low.2=§8Punisher:§r Jika kamu lengah, aku tidak akan datang menyelamatkanmu.
dialog.punisher.interact.low.3=§8Punisher:§r Buktikan bahwa aku bisa mempercayaimu.
dialog.punisher.interact.low.4=§8Punisher:§r Aku sudah melihat terlalu banyak pahlawan gugur karena memercayai orang yang salah.
dialog.punisher.interact.low.5=§8Punisher:§r Kurangi bicara. Tetap waspada.

dialog.punisher.interact.high.1=§8Punisher:§r Kamu sudah membuktikan bahwa kamu tahu cara bertahan hidup.
dialog.punisher.interact.high.2=§8Punisher:§r Aku jarang mengatakan ini... kerja bagus.
dialog.punisher.interact.high.3=§8Punisher:§r Lindungi punggungku, dan aku akan melindungi punggungmu.
dialog.punisher.interact.high.4=§8Punisher:§r Aku mulai berpikir bahwa kamu benar-benar membuat perbedaan.
dialog.punisher.interact.high.5=§8Punisher:§r Selama kita bertarung bersama, para penjahat itu tidak akan mendapat waktu istirahat.

dialog.punisher.follow=§8Punisher:§r Jangan pergi terlalu jauh.
dialog.punisher.free=§8Punisher:§r Jika sesuatu muncul, aku akan menanganinya.

dialog.punisher.recruit.1=§8Punisher:§r Kartu identitas itu membuktikan bahwa kamu bersama Avengers... Aku akan bekerja denganmu.
dialog.punisher.recruit.2=§8Punisher:§r Aku tidak menerima perintah dari sembarang orang. Tetapi aku akan memberimu kesempatan.

dialog.punisher.respect.1=§8Punisher:§r Kamu sedang belajar.
dialog.punisher.respect.2=§8Punisher:§r Kerja bagus.
dialog.punisher.respect.3=§8Punisher:§r Aku mulai mempercayaimu.
dialog.punisher.respect.4=§8Punisher:§r Itu profesional.

dialog.punisher.assist.1=§8Punisher:§r Tembakan bagus. Teruskan.
dialog.punisher.assist.2=§8Punisher:§r Kamu bertarung lebih baik daripada yang kuduga.
dialog.punisher.assist.3=§8Punisher:§r Hari ini kita memberi mereka pelajaran.
dialog.punisher.assist.4=§8Punisher:§r Bekerja denganmu membuat semuanya lebih mudah.

dialog.punisher.respect.25=§8Punisher:§r Sepertinya kamu tahu apa yang kamu lakukan.
dialog.punisher.respect.50=§8Punisher:§r Aku mulai mempercayaimu.
dialog.punisher.respect.75=§8Punisher:§r Kamu telah membuktikan dirimu sebagai sekutu sejati.
dialog.punisher.respect.100=§8Punisher:§r Jika suatu hari aku membutuhkan seseorang untuk menjaga punggungku, orang itu adalah kamu.

dialog.punisher.idle.1=§8Punisher:§r Tetap waspada.
dialog.punisher.idle.2=§8Punisher:§r Kota tidak pernah tidur.
dialog.punisher.idle.3=§8Punisher:§r Para penjahat selalu kembali.
dialog.punisher.idle.4=§8Punisher:§r Manfaatkan saat tenang ini sebaik-baiknya.
dialog.punisher.idle.5=§8Punisher:§r Jangan lengah.

