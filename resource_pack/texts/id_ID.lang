dialog.black_cat.aspect.locked=Dia masih belum cukup memercayaimu untuk menggunakan skin itu.
dialog.black_cat.aspect.changed=Black Cat mengubah skin-nya.

dialog.black_cat.assist.1=§dBlack Cat:§r Tidak buruk. Mungkin kamu memang berguna dalam pertarungan.
dialog.black_cat.assist.2=§dBlack Cat:§r Pukulan bagus. Kamu hampir membuatku terkesan.
dialog.black_cat.assist.3=§dBlack Cat:§r Kita tim yang bagus... jangan terlalu senang.
dialog.black_cat.assist.4=§dBlack Cat:§r Kuakui, itu penuh gaya.

dialog.black_cat.try_tame=§dBlack Cat:§r Jika kamu ingin aku bekerja denganmu, gunakan zamrud.
menu.black_cat.title=Black Cat

menu.black_cat.respect=Rasa hormat:
menu.black_cat.interact=Interaksi
menu.black_cat.follow_me=Ikuti saya
menu.black_cat.stop_following=Berhenti mengikuti saya

menu.black_cat.body.low_respect=Black Cat mengawasimu dengan waspada. Dia masih belum sepenuhnya memercayaimu.
menu.black_cat.body.high_respect=Black Cat mendekat dengan senyum percaya diri. Sepertinya dia menikmati kebersamaan denganmu.

dialog.black_cat.low_respect.1=§dBlack Cat:§r Jangan salah paham. Aku masih belum mempercayaimu.
dialog.black_cat.low_respect.2=§dBlack Cat:§r Jika ini berakhir buruk, aku tidak akan menyelamatkanmu untuk kedua kalinya.
dialog.black_cat.low_respect.3=§dBlack Cat:§r Kamu berguna... untuk sekarang.
dialog.black_cat.low_respect.4=§dBlack Cat:§r Jangan memberiku alasan untuk menyesalinya.
dialog.black_cat.low_respect.5=§dBlack Cat:§r Aku sudah lama bekerja sendirian. Jangan rusak ini.
dialog.black_cat.low_respect.6=§dBlack Cat:§r Kamu punya bakat, tetapi juga banyak masalah.
dialog.black_cat.low_respect.7=§dBlack Cat:§r Jangan lengah. Aku tidak akan lengah.
dialog.black_cat.low_respect.8=§dBlack Cat:§r Mungkin suatu hari kamu bisa mendapatkan kepercayaanku.

dialog.black_cat.high_respect.1=§dBlack Cat:§r Aku suka bekerja denganmu, laba-laba kecil.
dialog.black_cat.high_respect.2=§dBlack Cat:§r Kamu punya gaya. Tidak sebanyak aku, tetapi hampir.
dialog.black_cat.high_respect.3=§dBlack Cat:§r Aku tahu aku bisa mempercayaimu.
dialog.black_cat.high_respect.4=§dBlack Cat:§r Kuakui, bersamamu semuanya lebih menyenangkan.
dialog.black_cat.high_respect.5=§dBlack Cat:§r Kerja bagus. Kamu hampir membuatku terkesan.
dialog.black_cat.high_respect.6=§dBlack Cat:§r Saat kamu berada di dekatku, semuanya terasa tidak terlalu membosankan.
dialog.black_cat.high_respect.7=§dBlack Cat:§r Jangan terlalu senang, tetapi aku senang melihatmu.
dialog.black_cat.high_respect.8=§dBlack Cat:§r Lindungi punggungku, dan aku akan melindungi punggungmu.

dialog.black_cat.follow_me=§dBlack Cat:§r Baiklah, aku ikut denganmu. Hanya saja jangan berjalan terlalu lambat.
dialog.black_cat.stop_following=§dBlack Cat:§r Sempurna, aku akan tetap di sekitar sini. Jangan terlalu merindukanku.
dialog.black_cat.not_owner=§dBlack Cat:§r Maaf, sayang. Aku tidak bekerja untukmu.

entity.spidermanaddon:black_cat.name=Black Cat
