dialog.punisher.interact.low.1=§8Punisher:§r No confundas trabajar juntos con ser amigos.
dialog.punisher.interact.low.2=§8Punisher:§r Si bajas la guardia, no pienso rescatarte.
dialog.punisher.interact.low.3=§8Punisher:§r Demuéstrame que puedo confiar en ti.
dialog.punisher.interact.low.4=§8Punisher:§r He visto demasiados héroes caer por confiar en cualquiera.
dialog.punisher.interact.low.5=§8Punisher:§r Habla menos. Mantén los ojos abiertos.

dialog.punisher.interact.high.1=§8Punisher:§r Has demostrado que sabes sobrevivir.
dialog.punisher.interact.high.2=§8Punisher:§r No suelo decir esto... buen trabajo.
dialog.punisher.interact.high.3=§8Punisher:§r Si tú cubres mi espalda, yo cubriré la tuya.
dialog.punisher.interact.high.4=§8Punisher:§r Empiezo a pensar que haces la diferencia.
dialog.punisher.interact.high.5=§8Punisher:§r Mientras luchemos juntos, esos criminales no tendrán descanso.

dialog.punisher.follow=§8Punisher:§r No te alejes demasiado.
dialog.punisher.free=§8Punisher:§r Si algo aparece, me encargaré.

dialog.punisher.recruit.1=§8Punisher:§r Esa credencial demuestra que vienes de los Vengadores... Trabajaré contigo.
dialog.punisher.recruit.2=§8Punisher:§r No sigo órdenes de cualquiera. Pero te daré una oportunidad.

dialog.punisher.respect.1=§8Punisher:§r Vas aprendiendo.
dialog.punisher.respect.2=§8Punisher:§r Buen trabajo.
dialog.punisher.respect.3=§8Punisher:§r Empiezo a confiar en ti.
dialog.punisher.respect.4=§8Punisher:§r Eso fue profesional.

dialog.punisher.assist.1=§8Punisher:§r Buen disparo. Sigue así.
dialog.punisher.assist.2=§8Punisher:§r Peleas mejor de lo que esperaba.
dialog.punisher.assist.3=§8Punisher:§r Hoy les dimos una lección.
dialog.punisher.assist.4=§8Punisher:§r Trabajar contigo hace esto más sencillo.

dialog.punisher.respect.25=§8Punisher:§r Parece que sabes lo que haces.
dialog.punisher.respect.50=§8Punisher:§r Empiezo a confiar en ti.
dialog.punisher.respect.75=§8Punisher:§r Has demostrado ser un verdadero aliado.
dialog.punisher.respect.100=§8Punisher:§r Si alguna vez necesito a alguien cubriendo mi espalda, serás tú.

dialog.punisher.idle.1=§8Punisher:§r Mantente alerta.
dialog.punisher.idle.2=§8Punisher:§r La ciudad nunca duerme.
dialog.punisher.idle.3=§8Punisher:§r Los criminales siempre vuelven.
dialog.punisher.idle.4=§8Punisher:§r Aprovecha este momento de calma.
dialog.punisher.idle.5=§8Punisher:§r No bajes la guardia.

