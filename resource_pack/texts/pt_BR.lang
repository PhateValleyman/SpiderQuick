dialog.punisher.interact.low.1=§8Punisher:§r Não confunda trabalhar juntos com amizade.
dialog.punisher.interact.low.2=§8Punisher:§r Se baixar a guarda, não vou salvar você.
dialog.punisher.interact.low.3=§8Punisher:§r Prove que posso confiar em você.
dialog.punisher.interact.low.4=§8Punisher:§r Já vi heróis demais caírem por confiar em qualquer um.
dialog.punisher.interact.low.5=§8Punisher:§r Fale menos. Mantenha os olhos abertos.

dialog.punisher.interact.high.1=§8Punisher:§r Você provou que sabe sobreviver.
dialog.punisher.interact.high.2=§8Punisher:§r Não costumo dizer isso... bom trabalho.
dialog.punisher.interact.high.3=§8Punisher:§r Cubra minhas costas, e eu cubro as suas.
dialog.punisher.interact.high.4=§8Punisher:§r Estou começando a achar que você faz a diferença.
dialog.punisher.interact.high.5=§8Punisher:§r Enquanto lutarmos juntos, esses criminosos não terão descanso.

dialog.punisher.follow=§8Punisher:§r Não se afaste demais.
dialog.punisher.free=§8Punisher:§r Se alguma coisa aparecer, eu cuido disso.

dialog.punisher.recruit.1=§8Punisher:§r Essa credencial prova que você vem dos Vingadores... Vou trabalhar com você.
dialog.punisher.recruit.2=§8Punisher:§r Não recebo ordens de qualquer um. Mas vou dar uma chance a você.

dialog.punisher.respect.1=§8Punisher:§r Você está aprendendo.
dialog.punisher.respect.2=§8Punisher:§r Bom trabalho.
dialog.punisher.respect.3=§8Punisher:§r Estou começando a confiar em você.
dialog.punisher.respect.4=§8Punisher:§r Isso foi profissional.

dialog.punisher.assist.1=§8Punisher:§r Bom disparo. Continue assim.
dialog.punisher.assist.2=§8Punisher:§r Você luta melhor do que eu esperava.
dialog.punisher.assist.3=§8Punisher:§r Hoje demos uma lição neles.
dialog.punisher.assist.4=§8Punisher:§r Trabalhar com você torna isso mais fácil.

dialog.punisher.respect.25=§8Punisher:§r Parece que você sabe o que está fazendo.
dialog.punisher.respect.50=§8Punisher:§r Estou começando a confiar em você.
dialog.punisher.respect.75=§8Punisher:§r Você provou ser um verdadeiro aliado.
dialog.punisher.respect.100=§8Punisher:§r Se eu precisar de alguém cobrindo minhas costas, será você.

dialog.punisher.idle.1=§8Punisher:§r Fique alerta.
dialog.punisher.idle.2=§8Punisher:§r A cidade nunca dorme.
dialog.punisher.idle.3=§8Punisher:§r Os criminosos sempre voltam.
dialog.punisher.idle.4=§8Punisher:§r Aproveite este momento de calmaria.
dialog.punisher.idle.5=§8Punisher:§r Não baixe a guarda.

