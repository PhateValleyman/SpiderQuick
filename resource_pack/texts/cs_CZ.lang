dialog.punisher.heal.full=§8Punisher:§r Úplné zotavení. Jsem zpátky v boji.
dialog.punisher.heal.bad=§8Punisher:§r Tohle není pomoc. To bylo špatné rozhodnutí.

dialog.punisher.night.1=§8Punisher:§r Noc nahrává zločincům... a i nám.
