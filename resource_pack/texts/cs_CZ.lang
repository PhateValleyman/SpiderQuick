dialog.black_cat.aspect.changed=Black Cat změnila svůj vzhled.

dialog.black_cat.assist.1=§dBlack Cat:§r Není špatné. Možná jsi v boji užitečný.
dialog.black_cat.assist.2=§dBlack Cat:§r Hezký zásah. Téměř jsi mě ohromil.
dialog.black_cat.assist.3=§dBlack Cat:§r Jsme dobrý tým... nepřeháněj to.
dialog.black_cat.assist.4=§dBlack Cat:§r Přiznávám, to bylo stylové.

dialog.black_cat.try_tame=§dBlack Cat:§r Chceš-li, abych s tebou pracovala, použij smaragd.
