dialog.punisher.interact.low.1=§8Punisher:§r Nepleť si spolupráci s přátelstvím.
dialog.punisher.interact.low.2=§8Punisher:§r Když polevíš v ostražitosti, nepřijdu tě zachránit.
dialog.punisher.interact.low.3=§8Punisher:§r Dokaž, že ti můžu věřit.
dialog.punisher.interact.low.4=§8Punisher:§r Viděl jsem příliš mnoho hrdinů padnout, protože věřili špatným lidem.
dialog.punisher.interact.low.5=§8Punisher:§r Mluv méně. Měj oči otevřené.

dialog.punisher.interact.high.1=§8Punisher:§r Prokázal jsi, že umíš přežít.
dialog.punisher.interact.high.2=§8Punisher:§r Tohle často neříkám... dobrá práce.
dialog.punisher.interact.high.3=§8Punisher:§r Kryj mi záda a já pohlídám ta tvoje.
dialog.punisher.interact.high.4=§8Punisher:§r Začínám si myslet, že něco znamenáš.
dialog.punisher.interact.high.5=§8Punisher:§r Dokud bojujeme společně, ti zločinci nebudou mít chvíli klidu.

dialog.punisher.follow=§8Punisher:§r Nevzdaluj se příliš daleko.
dialog.punisher.free=§8Punisher:§r Když se něco objeví, já to vyřeším.

dialog.punisher.recruit.1=§8Punisher:§r Ten průkaz dokazuje, že jsi s Avengers... Budu s tebou spolupracovat.
dialog.punisher.recruit.2=§8Punisher:§r Neberu rozkazy od kohokoliv. Ale dám ti šanci.

dialog.punisher.respect.1=§8Punisher:§r Učíš se.
dialog.punisher.respect.2=§8Punisher:§r Dobrá práce.
dialog.punisher.respect.3=§8Punisher:§r Začínám ti věřit.
dialog.punisher.respect.4=§8Punisher:§r To bylo profesionální.

dialog.punisher.assist.1=§8Punisher:§r Hezký zásah. Pokračuj.
dialog.punisher.assist.2=§8Punisher:§r Bojuješ lépe, než jsem čekal.
dialog.punisher.assist.3=§8Punisher:§r Dnes jsme jim dali lekci.
dialog.punisher.assist.4=§8Punisher:§r Práce s tebou to usnadňuje.

dialog.punisher.respect.25=§8Punisher:§r Vypadá to, že víš, co děláš.
dialog.punisher.respect.50=§8Punisher:§r Začínám ti důvěřovat.
dialog.punisher.respect.75=§8Punisher:§r Prokázal jsi, že jsi skutečný spojenec.
dialog.punisher.respect.100=§8Punisher:§r Když budu někdy potřebovat někoho, kdo mi bude krýt záda, budeš to ty.

dialog.punisher.idle.1=§8Punisher:§r Buď ve střehu.
dialog.punisher.idle.2=§8Punisher:§r Město nikdy nespí.
dialog.punisher.idle.3=§8Punisher:§r Zločinci se vždy vrací.
dialog.punisher.idle.4=§8Punisher:§r Využij tuto tichou chvíli.
dialog.punisher.idle.5=§8Punisher:§r Nesnižuj svou ostražitost.

