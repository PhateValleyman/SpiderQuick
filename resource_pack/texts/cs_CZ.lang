menu.black_cat.body.low_respect=Black Cat vás opatrně pozoruje. Stále vám plně nedůvěřuje.
menu.black_cat.body.high_respect=Black Cat přistoupí se sebevědomým úsměvem. Zdá se, že si užívá vaši společnost.

dialog.black_cat.low_respect.1=§dBlack Cat:§r Nechápej to špatně. Stále ti nedůvěřuji.
dialog.black_cat.low_respect.2=§dBlack Cat:§r Pokud se to zvrtne, nebudu tě zachraňovat dvakrát.
dialog.black_cat.low_respect.3=§dBlack Cat:§r Jsi užitečný... zatím.
dialog.black_cat.low_respect.4=§dBlack Cat:§r Nedávej mi důvod toho litovat.
dialog.black_cat.low_respect.5=§dBlack Cat:§r Dlouho jsem pracovala sama. Nenič to.
dialog.black_cat.low_respect.6=§dBlack Cat:§r Máš talent, ale máš taky spoustu problémů.
dialog.black_cat.low_respect.7=§dBlack Cat:§r Neztrácej ostražitost. Já ne.
dialog.black_cat.low_respect.8=§dBlack Cat:§r Možná si jednou zasloužíš mou důvěru.

dialog.black_cat.high_respect.1=§dBlack Cat:§r Ráda s tebou pracuji, malý pavoučku.
dialog.black_cat.high_respect.2=§dBlack Cat:§r Máš styl. Ne tolik jako já, ale blízko.
dialog.black_cat.high_respect.3=§dBlack Cat:§r Věděla jsem, že ti můžu věřit.
dialog.black_cat.high_respect.4=§dBlack Cat:§r Přiznávám, děláš to zábavnějším.
dialog.black_cat.high_respect.5=§dBlack Cat:§r Dobrá práce. Téměř jsi mě ohromil.
dialog.black_cat.high_respect.6=§dBlack Cat:§r S tebou poblíž je to méně nudné.
dialog.black_cat.high_respect.7=§dBlack Cat:§r Nebuď příliš nadšený, ale jsem ráda, že tě vidím.
dialog.black_cat.high_respect.8=§dBlack Cat:§r Kryj mi záda a já pohlídám ta tvoje.

dialog.black_cat.follow_me=§dBlack Cat:§r Dobře, půjdu s tebou. Jen nechoď tak pomalu.
dialog.black_cat.stop_following=§dBlack Cat:§r Perfektní, zůstanu tady poblíž. Příliš mi tu nechyběj.
dialog.black_cat.not_owner=§dBlack Cat:§r Promiň, miláčku. Nepracuju pro tebe.

action.interact.black_cat=Promluvit
