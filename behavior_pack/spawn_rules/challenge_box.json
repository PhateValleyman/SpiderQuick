{
  "format_version": "1.8.0",
  "minecraft:spawn_rules": {
    "description": {
      "identifier": "spidermanaddon:challenge_box",
      "population_control": "monster"
    },
    "conditions": [
      {
        "minecraft:spawns_on_surface": {},
        "minecraft:spawns_on_block_filter": [
            "minecraft:grass_block"
        ],
        "minecraft:brightness_filter": {
          "min": 0,
          "max": 7,
          "adjust_for_weather": false
        },
        "minecraft:biome_filter": {
          "all_of": [
            {
              "any_of": [
                {
                  "test": "has_biome_tag",
                  "operator": "==",
                  "value": "desert"
                },
                {
                  "test": "has_biome_tag",
                  "operator": "==",
                  "value": "jungle"
                },
                {
                  "test": "has_biome_tag",
                  "operator": "==",
                  "value": "plains"
                },
                {
                  "test": "has_biome_tag",
                  "operator": "==",
                  "value": "savanna"
                }
              ]
            }
          ]
        },
        "minecraft:weight": {
          "default": 15
        },
        "minecraft:herd": {
          "min_size": 1,
          "max_size": 1
        }
      }
    ]
  }
}
