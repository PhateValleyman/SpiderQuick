{
  "format_version": "1.13.0",
  "minecraft:single_block_feature": {
    "description": {
      "identifier": "spidermanaddon:sand_crystal"
    },
    "places_block": "spidermanaddon:sand_crystal",
    "enforce_placement_rules": true,
    "enforce_survivability_rules": true,
    "may_replace": [
      "minecraft:air"
    ],
    "may_attach_to": {
      "auto_rotate": false,
      "min_sides_must_attach": 1,
      "bottom": [
        "minecraft:sand",
        "minecraft:sandstone",
        "minecraft:stone",
        "minecraft:dirt",
        "minecraft:grass",
        "minecraft:gravel",
        "spidermanaddon:sand_crystal_block"
      ]
    },
    "may_not_attach_to": {
      "all": [
        "minecraft:water",
        "minecraft:flowing_water"
      ]
    }
  }
}
