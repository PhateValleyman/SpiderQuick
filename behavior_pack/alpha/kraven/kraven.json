{
  "format_version": "1.8.0",
  "minecraft:entity": {
	"description": {
      "identifier": "spidermanaddon:kraven",
         "is_spawnable":true,
         "is_summonable":true,
         "is_experimental":false,
      "scripts": {
		"pre_animation": [
			"variable.attack = Math.sin(variable.attack_time * 38.17);"
		],
        "animate": [ 
			"kraven_IA.c",
			"granadas.c"
		]
      },
      "animations": {
		  "kraven_IA.c": "controller.animation.kraven.ia",
		  "kraven_IA": "animation.kraven.ia",
		  "granadas.c": "controller.animation.kraven.granadas",
		  "granadas": "animation.kraven.granadas"
      }
    },
    "components": {
        "minecraft:experience_reward": {
          "on_bred": "Math.Random(10,50)",
          "on_death": "query.last_hit_by_player ? Math.Random(5,30) : 0"
        },
      "minecraft:knockback_resistance": {
        "value": 0.75
      },
      "minecraft:boss": {
        "should_darken_sky": false,
		"name":"Kraven",
        "hud_range": 100
      },
      "minecraft:fire_immune": true,
      "minecraft:burns_in_daylight": false,
      "minecraft:type_family": {
        "family": [ "monster", "kraven", "mob" ]
      },
      "minecraft:breathable": {
        "totalSupply": 15,
        "suffocateTime": 0
      },
      "minecraft:collision_box": {
        "width": 0.8,
        "height": 1.9
      },
      "minecraft:loot": {
        "table": "loot_tables/entities/kraven.json"
      },
      "minecraft:health": {
        "value": 2500,
		"max": 2500
      },
      "minecraft:scale": {
        "value": 1.05
      },
      "minecraft:navigation.walk": {
        "can_float": true,
        "avoid_water": true,
        "avoid_damage_blocks": true
      },
      "minecraft:movement.basic": {
        
      },
      "minecraft:jump.static": {
      },
      "minecraft:nameable": {
      },
      "minecraft:leashable": {
        "soft_distance": 4.0,
        "hard_distance": 30.0,
        "max_distance": 30.0,
        "on_leash": {
          "event": "minecraft:on_leash",
          "target": "self"
        },
        "on_unleash": {
          "event": "minecraft:on_unleash",
          "target": "self"
        }
      },
      "minecraft:balloonable": {
      },
      "minecraft:behavior.float": {
        "priority": 0
      },
      "minecraft:behavior.break_door": {
        "priority": 1
      },
      "minecraft:behavior.move_towards_restriction": {
        "priority": 4,
        "speed_multiplier": 1
      },
      "minecraft:behavior.random_stroll": {
        "priority": 6,
        "speed_multiplier": 0.7
      },
      "minecraft:behavior.look_at_player": {
        "priority": 7,
        "look_distance": 6.0,
        "probability": 0.02
      },
      "minecraft:behavior.random_look_around": {
        "priority": 8
      },
	    "minecraft:physics": {
      }
    },
    "component_groups": {
      "kraven:crossbow": {
        "minecraft:mark_variant": {
          "value": 1
        }
	  },
      "kraven:rifle": {
        "minecraft:mark_variant": {
          "value": 2
        }
	  },
      "kraven:granadas": {
        "minecraft:mark_variant": {
          "value": 3
        }
	  },
      "kraven:axe": {
        "minecraft:mark_variant": {
          "value": 4
        }
	  },
      "kraven:lanza": {
        "minecraft:mark_variant": {
          "value": 5
        }
	  },
      "kraven:attack_mode": {
      "minecraft:behavior.hurt_by_target": {
        "priority": 1
      },
      "minecraft:behavior.nearest_attackable_target": {
        "priority": 1,
        "within_radius": 45.5,
        "entity_types": [
          {
            "filters": { "other_with_families": [ "player" ] },
            "max_dist": 45.5
          }
        ]
      },
      "minecraft:movement": {
        "value": {
          "range_min": 0.4, 
          "range_max": 0.4
        }
      },
      "minecraft:attack": {
        "damage": 12.5
	  },
      "minecraft:behavior.melee_attack": {
        "priority": 1,
        "speed_multiplier": 1.4,
        "track_target": false
	  },
        "minecraft:mark_variant": {
          "value": 0
        }
	  }
	},
	"events": {
      "minecraft:entity_spawned": {
        "add": {
            "component_groups": [
              "kraven:attack_mode"
           ]
        }
      },
      "kraven:hability_on": {
        "sequence": [
          {
            "randomize": [
              {
                "weight": 20,
                "remove": {
                },
                "add": {
                  "component_groups": [
                    "kraven:crossbow"
                  ]
                }
              },
              {
                "weight": 20,
                "remove": {
                },
                "add": {
                  "component_groups": [
                    "kraven:rifle"
                  ]
                }
              },
              {
                "weight": 20,
                "remove": {
                },
                "add": {
                  "component_groups": [
                    "kraven:granadas"
                  ]
                }
              },
              {
                "weight": 20,
                "remove": {
                },
                "add": {
                  "component_groups": [
                    "kraven:axe"
                  ]
                }
              },
              {
                "weight": 20,
                "remove": {
                },
                "add": {
                  "component_groups": [
                    "kraven:lanza"
                  ]
                }
              }
            ]
          }
        ]
      },
      "kraven:attack_mode": {
        "add": {
            "component_groups": [
              "kraven:attack_mode"
           ]
        },
        "remove": {
            "component_groups": [
              "kraven:crossbow",
			  "kraven:rifle",
			  "kraven:granadas",
			  "kraven:axe",
			  "kraven:lanza"
           ]
        }
      }
	}
  }
}