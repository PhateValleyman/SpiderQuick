{
  "format_version": "1.13.0",
  "minecraft:entity": {
    "description": {
      "identifier": "spidermanaddon:kraven_granadas",
      "is_spawnable": true,
      "is_summonable": true,
      "is_experimental": false
    },
	"component_groups": {
	  "minecraft:despawn": {
				"minecraft:instant_despawn": {
					"remove_child_entities": true
				}
	  },
	  "minecraft:contador": {
	   "minecraft:area_attack" : {
          "damage_range": 3.25,
          "damage_per_tick": 30.0,
          "cause": "contact"
        },
			"minecraft:timer": {
			  "looping": false,
			  "time": 0.1,
			  "randomInterval": false,
			  "time_down_event": {
				"event": "minecraft:dont_eat"
			  }
		}
	  }
	},
	
    "components": {
      "minecraft:type_family": {
        "family": [ "blocks" ]
      },
      "minecraft:collision_box": {
        "width": 0.5,
        "height": 0.5
      },
      "minecraft:fire_immune": true,
      "minecraft:knockback_resistance": {
        "value": 1.0
      },
      "minecraft:damage_sensor": {
        "triggers": {
          "cause": "all",
          "deals_damage": false
        }
      },
      "minecraft:health": {
        "value": 10,
        "max": 10
      },
			"minecraft:timer": {
			  "looping": false,
			  "time": 2,
			  "randomInterval": false,
			  "time_down_event": {
				"event": "minecraft:contar"
			  }
		},
      "minecraft:hurt_on_condition": {
        "damage_conditions": [
          {
            "filters": { "test": "in_lava", "subject": "self", "operator": "==", "value": true },
            "cause": "lava",
            "damage_per_tick": 0
          }
        ]
      },
      "minecraft:loot": {
        "table": "loot_tables/blocks/spikes.json"
      },
      "minecraft:nameable": {
      },
      "minecraft:persistent": {
      },
      "minecraft:physics": {
      },
      "minecraft:pushable": {
        "is_pushable": false,
        "is_pushable_by_piston": false
      }
    },

    "events": {
      "minecraft:contar": {
            "run_command": {
              "command": [
				"playsound spiderman_effects.kick_blast @a[r=20]",
				"particle spidermanaddon:yellow_electric_hit ~ ~ ~",
				"particle spidermanaddon:yellow_electric_hit2 ~ ~ ~",
				"particle spidermanaddon:yellow_electric_hit3 ~ ~ ~"
              ]
            },
        "add": {
          "component_groups": [
            "minecraft:contador"
          ]
        }
      },
      "minecraft:dont_eat": {
        "add": {
          "component_groups": [
            "minecraft:despawn"
          ]
        }
      }
    }
  }
}
