{
	"format_version": "1.10.0",
	"animation_controllers": {
		"controller.animation.spiderman.run" : {
			"initial_state" : "default",
			"states" : {
				"default" : {
					"transitions" : [
						{
							"venom.run" : "q.equipped_item_any_tag('slot.armor.head', 'venom') && q.is_sprinting"
						},
						{
							"spiderman.run" : "q.equipped_item_any_tag('slot.armor.head', 'venom') && q.is_sprinting"
						}
					]
				},
				"venom.run" : {
					"animations" : [ "venom.run" ],
					"transitions" : [
						{
							"default" : "!q.equipped_item_any_tag('slot.armor.head', 'venom') || !q.is_sprinting"
						}
					]
				},
				"spiderman.run" : {
					"animations" : [ "spiderman.run" ],
					"transitions" : [
						{
							"default" : "!q.equipped_item_any_tag('slot.armor.head', 'venom') || !q.is_sprinting"
						}
					]
				}
			}
		}
	}
}