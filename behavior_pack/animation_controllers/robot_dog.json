{
	"format_version": "1.10.0",
	"animation_controllers": {
		"controller.animation.robot_dog.ia" : {
			"initial_state" : "default",
			"states" : {
				"default" : {
					"on_entry": [
						"/event entity @s minecraft:default"
					],
					"transitions" : [
						{
							"robot_dog.ia" : "q.has_target"
						}
					]
				},
				"robot_dog.ia" : {
					"animations" : [ "robot_dog_IA" ],
					"transitions" : [
						{
							"default" : "!q.has_target"
						}
					]
				}
			}
		}
	}
}