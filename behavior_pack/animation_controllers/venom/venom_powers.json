{
  "format_version": "1.10.0",
  "animation_controllers": {
		"controller.animation.player.venom" : {
			"initial_state" : "default",
			"states" : {
				"default" : {
					"animations" : [ 
						"player.venom.powers.c",
						"player.venom.transform_item.c",
						"player.venom.attack.properties.c",
						"player.venom.impulse_whip.c",
						"player.venom.explotion.c",
						"player.venom.whip.attack.c",
						"player.venom.shield.c",
						"player.venom.attack.sounds.c",
						"player.symbiont.rage.c"
					]
				}
			}
		},
		"controller.animation.player.symbiont.rage": {
		  "initial_state": "default",
		  "states": {
			"default": {
					"on_entry": [
						"/stopsound @s venom.ambient"
					],
			  "transitions": [
				{ "attack": "q.scoreboard('venom_rage') == 1" }
			  ]
			},
			"attack": {
				"animations" : [ 
					"player.venom.ambient"
				],
				"transitions": [{ "default": "q.scoreboard('venom_rage') == 0" }]
			}
		  }
		},
		"controller.animation.player.venom.attack.sounds": {
		  "initial_state": "default",
		  "states": {
			"default": {
			  "transitions": [
				{ "attack": "!q.equipped_item_any_tag('slot.armor.head', 'venom_transform') && v.attack_time > 0.1 && q.equipped_item_any_tag('slot.weapon.mainhand', 'venom_knife_sounds')" }
			  ]
			},
			"attack": {
					"animations" : [ 
						"player.venom.time"
					],
				"on_entry": [ "/playsound venom.axe @a[r=10] ~ ~ ~ 0.5" ],
				  "transitions": [{ "default": "q.all_animations_finished" }]
			}
		  }
		},
		"controller.animation.player.venom.changes_skin" : {
			"initial_state" : "default",
			"states" : {
				"default" : {
					"transitions" : [
						{
							"venom.changes_skin" : "q.property('nido:ability1') == 1"
						}
					]
				},
				"venom.changes_skin" : {
					"animations" : [ 
						{ "venom.changes_skin.default": "q.property('arathnido:skins') == 0 || q.property('arathnido:skins') == 3 || q.property('arathnido:skins') == 1 || q.property('arathnido:skins') == 7" },
						{ "venom.changes_skin.ultimate": "q.property('arathnido:skins') == 4 || q.property('arathnido:skins') == 5" },
						{ "venom.changes_skin.blue": "q.property('arathnido:skins') == 2" },
						{ "venom.changes_skin.2099": "q.property('arathnido:skins') == 6"},
						{ "venom.changes_skin.snow": "q.property('arathnido:skins') == 8"},
						{ "venom.changes_skin.antivenom": "q.property('arathnido:skins') == 9"}
					],
					"transitions" : [
						{
							"end" : "q.any_animation_finished"
						}
					]
				},
				"end" : {
					"animations" : [ 
						{ "venom.changes_skin.default.end": "q.property('arathnido:skins') == 0 || q.property('arathnido:skins') == 3 || q.property('arathnido:skins') == 1 || q.property('arathnido:skins') == 7" },
						{ "venom.changes_skin.ultimate.end": "q.property('arathnido:skins') == 4 || q.property('arathnido:skins') == 5" },
						{ "venom.changes_skin.blue.end": "q.property('arathnido:skins') == 2" },
						{ "venom.changes_skin.2099.end": "q.property('arathnido:skins') == 6" },
						{ "venom.changes_skin.snow.end": "q.property('arathnido:skins') == 8" },
						{ "venom.changes_skin.antivenom.end": "q.property('arathnido:skins') == 9" }
					],
					"transitions" : [
						{
							"default" : "q.any_animation_finished"
						}
					]
				}
			}
		},
		"controller.animation.player.venom.avatar" : {
			"initial_state" : "active",
			"states" : {
				"active" : {
					"transitions" : [
						{ "default" : "(1.0)" }
					]
				},
				"default" : {
					"on_entry" : [ "/scoreboard objectives add venom_avatar dummy", "/scoreboard players add @s venom_avatar 0", "/scoreboard objectives add venom_powers dummy", "/scoreboard players add @s venom_powers 0", "/function venom/avatar_off" ],
					"transitions" : [
						{ "avatar" : "q.scoreboard('venom_avatar') == 1 && q.is_alive" }
					]
				},
				"avatar" : {
					"on_entry" : [ "/function venom/avatar_off" ],
					"transitions" : [
						{
							"on" : "(1.0)"
						}
					]
				},
				"on" : {
					"on_entry" : [ "/function venom/avatar_on" ],
					"transitions" : [
						{ "default" : "!q.is_alive" },
						{ "off" : "q.scoreboard('venom_avatar') == 0" }
					]
				},
				"off" : {
					"on_entry" : [ "/scoreboard players set @s venom_powers 0", "/function venom/avatar_off", "/function venom/off_powers" ],
					"transitions" : [
						{ "default" : "(1.0)" }
					]
				}
			}
		},
		"controller.animation.player.venom.shield" : {
			"initial_state" : "default",
			"states" : {
				"default" : {
					"on_entry" : ["/event entity @s guns:shoot.off", "/tag @s remove venom_shield" ],
					"transitions" : [
						{
							"venom.shield" : "q.equipped_item_any_tag('slot.weapon.mainhand', 'venom_shield') && q.is_using_item"
						}
					]
				},
				"venom.shield" : {
					"on_entry" : ["/event entity @s guns:shoot" ],
					"animations" : [ "player.venom.shield" ],
					"transitions" : [
						{
							"default" : "q.any_animation_finished && !q.is_using_item"
						}
					]
				}
			}
		},
		"controller.animation.player.venom.axe.attack" : {
			"initial_state" : "default",
			"states" : {
				"default" : {
					"on_entry" : [ "/event entity @s venom:attacks.0", "/tag @s remove venom_attacking" ],
					"transitions" : [
						{
							"venom.attack.1" : "q.equipped_item_any_tag('slot.weapon.mainhand', 'venom_axe') && variable.attack_time > 0.1 && !q.is_sneaking"
						}
					]
				},
				"venom.attack.1" : {
					"on_entry" : [ "/event entity @s venom:attacks.12" ],
					"animations" : [ "player.venom.axe.attack", "player.venom.attack.time.2" ],
					"transitions" : [
						{	"default" : "q.all_animations_finished && (!q.is_using_item || !q.equipped_item_any_tag('slot.weapon.mainhand', 'venom_axe'))" },
						{	"venom.attack.2" : "q.any_animation_finished && variable.attack_time > 0.1" }
					]
				},
				"venom.attack.2" : {
					"on_entry" : [ "/event entity @s venom:attacks.6" ],
					"animations" : [ "player.venom.axe.attack", "player.venom.attack.time.2" ],
					"transitions" : [
						{	"default" : "q.all_animations_finished && (!q.is_using_item || !q.equipped_item_any_tag('slot.weapon.mainhand', 'venom_axe'))" },
						{	"venom.attack.1" : "q.any_animation_finished && variable.attack_time > 0.1" }
					]
				}
			}
		},
		"controller.animation.player.venom.knife.attack" : {
			"initial_state" : "default",
			"states" : {
				"default" : {
					"on_entry" : [ "/event entity @s venom:attacks.0", "/tag @s remove venom_attacking" ],
					"transitions" : [
						{
							"venom.attack.1" : "q.equipped_item_any_tag('slot.weapon.mainhand', 'venom_knife_whip') && variable.attack_time > 0.1 && !q.is_sneaking"
						}
					]
				},
				"venom.attack.1" : {
					"on_entry" : [ "/event entity @s venom:attacks.5" ],
					"animations" : [ "player.venom.knife.attack", "player.venom.attack.time.2" ],
					"transitions" : [
						{	"default" : "q.all_animations_finished && (!q.is_using_item || !q.equipped_item_any_tag('slot.weapon.mainhand', 'venom_knife_whip'))" },
						{	"venom.attack.2" : "q.any_animation_finished && variable.attack_time > 0.1" }
					]
				},
				"venom.attack.2" : {
					"on_entry" : [ "/event entity @s venom:attacks.6" ],
					"animations" : [ "player.venom.knife.attack", "player.venom.attack.time.2" ],
					"transitions" : [
						{	"default" : "q.all_animations_finished && (!q.is_using_item || !q.equipped_item_any_tag('slot.weapon.mainhand', 'venom_knife_whip'))" },
						{	"venom.attack.1" : "q.any_animation_finished && variable.attack_time > 0.1" }
					]
				}
			}
		},
		"controller.animation.player.symbiont.whip" : {
			"initial_state" : "default",
			"states" : {
				"default" : {
					"on_entry" : [ "/event entity @s guns:shoot.off" ],
					"transitions" : [
						{
							"attack.1" : "!q.equipped_item_any_tag('slot.armor.head', 'venom_transform') && q.equipped_item_any_tag('slot.weapon.mainhand', 'venom_knife_whip') && q.is_using_item"
						}
					]
				},
				"attack.1" : {
					"on_entry" : [ "/event entity @s guns:shoot" ],
					"animations" : [ "player.symbiont.whip.attack.1" ],
					"transitions" : [
						{ "default" : "q.equipped_item_any_tag('slot.armor.head', 'venom_transform') || (q.any_animation_finished && !q.is_using_item)" },
						{ "attack.2" : "q.any_animation_finished && q.equipped_item_any_tag('slot.weapon.mainhand', 'venom_knife_whip') && q.is_using_item" }
					]
				},
				"attack.2" : {
					"on_entry" : [ "/event entity @s guns:shoot" ],
					"animations" : [ "player.symbiont.whip.attack.2" ],
					"transitions" : [
						{ "default" : "q.equipped_item_any_tag('slot.armor.head', 'venom_transform') || (q.any_animation_finished && !q.is_using_item)" },
						{ "attack.1" : "q.any_animation_finished && q.equipped_item_any_tag('slot.weapon.mainhand', 'venom_knife_whip') && q.is_using_item" }
					]
				}
			}
		},
		"controller.animation.player.venom.whip.attack" : {
			"initial_state" : "default",
			"states" : {
				"default" : {
					"on_entry" : [ "/event entity @s venom:attacks.0", "/tag @s remove venom_attacking" ],
					"transitions" : [
						{
							"venom.attack.1" : "q.equipped_item_any_tag('slot.armor.head', 'venom_transform') && q.equipped_item_any_tag('slot.weapon.mainhand', 'venom_knife_whip') && q.is_using_item && !q.is_sneaking"
						}
					]
				},
				"venom.attack.1" : {
					"on_entry" : [ "/event entity @s venom:attacks.8" ],
					"animations" : [ "player.venom.whip.attack.1", "player.venom.attack.time.2" ],
					"transitions" : [
						{	"default" : "!q.equipped_item_any_tag('slot.armor.head', 'venom_transform') || (q.all_animations_finished && (!q.is_using_item || !q.equipped_item_any_tag('slot.weapon.mainhand', 'venom_knife_whip')))" },
						{	"venom.attack.2" : "q.any_animation_finished && q.is_using_item" }
					]
				},
				"venom.attack.2" : {
					"on_entry" : [ "/event entity @s venom:attacks.9" ],
					"animations" : [ "player.venom.whip.attack.2", "player.venom.attack.time.2" ],
					"transitions" : [
						{	"default" : "!q.equipped_item_any_tag('slot.armor.head', 'venom_transform') || (q.all_animations_finished && (!q.is_using_item || !q.equipped_item_any_tag('slot.weapon.mainhand', 'venom_knife_whip')))" },
						{	"venom.attack.3" : "q.any_animation_finished && q.is_using_item" }
					]
				},
				"venom.attack.3" : {
					"on_entry" : [ "/event entity @s venom:attacks.10" ],
					"animations" : [ "player.venom.whip.attack.3", "player.venom.attack.time.2" ],
					"transitions" : [
						{	"default" : "!q.equipped_item_any_tag('slot.armor.head', 'venom_transform') || (q.all_animations_finished && (!q.is_using_item || !q.equipped_item_any_tag('slot.weapon.mainhand', 'venom_knife_whip')))" },
						{	"venom.attack.4" : "q.any_animation_finished && q.is_using_item" }
					]
				},
				"venom.attack.4" : {
					"on_entry" : [ "/event entity @s venom:attacks.11" ],
					"animations" : [ "player.venom.whip.attack.4", "player.venom.attack.time.2" ],
					"transitions" : [
						{	"default" : "q.all_animations_finished" }
					]
				}
			}
		},
		"controller.animation.player.venom.climb" : {
			"initial_state" : "default",
			"states" : {
				"default" : {
					"on_entry" : [ 
						"/effect @s levitation 0 30 true",
						"/effect @s slow_falling 0 1 true",
						"/tag @s remove venom_climb", "/event entity @s mutant_fly:fisicas_on"
					],
					"transitions" : [
						{
							"climb.default" : "q.is_sneaking && q.property('arathnido:escalar') == true && !q.is_on_ground && !q.is_in_water"
						}
					]
				},
				"climb.default" : {
					"transitions" : [
						{ "default" : "q.property('arathnido:escalar') == false || q.is_on_ground || q.is_in_water" },
						{ "climb.down" : "!q.is_sneaking" },
						{ "climb.run" : "q.is_jumping" }
					],
					"animations" : [ 
						"player.venom.climb.default"
					],
					"on_entry" : [ 
						"/effect @s slow_falling 0 1 true",
						"/effect @s levitation 0 30 true", "/event entity @s mutant_fly:fisicas_off"
					]
				},
				"climb.run" : {
					"transitions" : [
						{ "default" : "q.property('arathnido:escalar') == false || q.is_on_ground || q.is_in_water" },
						{ "climb.down" : "!q.is_sneaking" }
					],
					"animations" : [ 
						"player.venom.climb.impulso"
					],
					"on_entry" : [ 
						"/effect @s slow_falling 0 1 true",
						"/effect @s levitation infinite 29 true",
						"/tag @s remove venom_climb", "/event entity @s mutant_fly:fisicas_on"
					]
				},
				"climb.on" : {
					"on_entry" : [ 
						"/tag @s remove venom_climb", "/event entity @s mutant_fly:fisicas_on"
					],
					"transitions" : [
						{ "default" : "q.property('arathnido:escalar') == false || q.is_on_ground || q.is_in_water" },
						{ "climb.default" : "q.is_sneaking" },
						{ "climb.down" : "!q.is_jumping" }
					],
					"animations" : [ 
						"player.venom.climb.on"
					]
				},
				"climb.down" : {
					"on_entry" : [ 
						"/effect @s levitation 0 30 true",
						"/tag @s remove venom_climb", "/event entity @s mutant_fly:fisicas_on"
					],
					"transitions" : [
						{ "default" : "q.property('arathnido:escalar') == false || q.is_on_ground || q.is_in_water" },
						{ "climb.default" : "q.is_sneaking" },
						{ "climb.on" : "q.is_jumping" }
					],
					"animations" : [ 
						"player.venom.climb.down"
					]
				}
			}
		},
		"controller.animation.player.venom.explotion" : {
			"initial_state" : "default",
			"states" : {
				"default" : {
					"on_entry" : [ 
						"/event entity @s guns:shoot.off", "/tag @s remove blast_player"
					],
					"transitions" : [
						{ "venom.explotion" : "q.equipped_item_any_tag('slot.weapon.mainhand', 'venom_explotion') && q.is_using_item" }
					],
					"blend_transition": 0.1
				},
				"venom.explotion" : {
					"on_entry" : [ 
						"/event entity @s guns:shoot"
					],
					"animations" : [ "player.venom.explotion" ],
					"transitions" : [
						{
							"default" : "q.property('arathnido:animation') == 0 && q.all_animations_finished"
						}
					]
				}
			}
		},
		"controller.animation.player.venom.impulse_whip" : {
			"initial_state" : "default",
			"states" : {
				"default" : {
					"on_entry" : [ 
						"/event entity @s guns:shoot.off", "/tag @s remove venom_swing"
					],
					"transitions" : [
						{ "venom.whip" : "q.equipped_item_any_tag('slot.weapon.mainhand', 'venom_whip') && q.is_using_item && q.is_sneaking && q.property('arathnido:animation') == 0" }
					],
					"blend_transition": 0.1
				},
				"venom.whip" : {
					"on_entry" : [ 
						"/event entity @s venom:whip_impulse"
					],
					"animations" : [ "player.venom.impulse_whip" ],
					"transitions" : [
						{
							"default" : "q.property('arathnido:animation') == 0 && q.all_animations_finished"
						}
					]
				}
			}
		},
		"controller.animation.player.venom.combat" : {
			"initial_state" : "default",
			"states" : {
				"default" : {
					"on_entry" : [ "/inputpermission set @s movement enabled", "/event entity @s venom:attacks.0", "/tag @s remove venom_hability", "/effect @s speed infinite 1 true", "/tag @s remove venom_special_attack", "/tag @s remove venom_smash", "/tag @s remove venom_smash_i", "/tag @s remove venom_hability", "/tag @s remove venom_attacking"  ],
					"transitions" : [
						{
							"venom.attack.1" : "q.equipped_item_any_tag('slot.armor.head', 'venom_transform') && q.equipped_item_any_tag('slot.weapon.mainhand', 'venom_item') && q.property('arathnido:attack') == true && !q.is_sneaking && q.is_on_ground && q.property('arathnido:take') == false"
						},
						{
							"venom.attack.aire" : "q.equipped_item_any_tag('slot.armor.head', 'venom_transform') && q.equipped_item_any_tag('slot.weapon.mainhand', 'venom_item') && q.property('arathnido:attack') == true && !q.is_sneaking && !q.is_on_ground && q.property('arathnido:take') == false"
						},
						{
							"venom.smash" : "q.equipped_item_any_tag('slot.armor.head', 'venom_transform') && q.equipped_item_any_tag('slot.weapon.mainhand', 'venom_item') && q.property('arathnido:attack') == true && q.is_sneaking && !q.is_on_ground && q.property('arathnido:take') == false"
						},
						{
							"venom.hability" : "q.equipped_item_any_tag('slot.armor.head', 'venom_transform') && q.is_sneaking && q.head_x_rotation(0) > 75 && q.is_on_ground && q.property('arathnido:take') == false"
						},
						{
							"venom.special_attack" : "q.equipped_item_any_tag('slot.armor.head', 'venom_transform') && q.equipped_item_any_tag('slot.weapon.mainhand', 'venom_item') && q.property('arathnido:attack') == true && q.is_sneaking && q.is_on_ground && q.property('arathnido:take') == false"
						}
					]
				},
				"venom.special_attack" : {
					"animations" : [ 
						{ "player.venom.special_attack": "q.property('arathnido:skins') == 0 || q.property('arathnido:skins') == 1 || q.property('arathnido:skins') == 3 || q.property('arathnido:skins') == 7" },
						{ "player.ultimate_venom.special_attack":"q.property('arathnido:skins') == 4 || q.property('arathnido:skins') == 5"}, 
						{ "player.blue_venom.special_attack":"q.property('arathnido:skins') == 2"}, 
						{ "player.venom_2099.special_attack":"q.property('arathnido:skins') == 6"}, 
						{ "player.venom_snow.special_attack":"q.property('arathnido:skins') == 8"}, 
						{ "player.antivenom.special_attack":"q.property('arathnido:skins') == 9"}
					],
					"transitions" : [
						{ "default" : "q.any_animation_finished" }
					]
				},
				"venom.hability" : {
					"on_entry" : [ 
						"/playsound venom.hability @a[r=15]", "/tag @s remove venom_hability"
					],
					"animations" : [ 
						{"player.venom.hability":"q.property('arathnido:skins') == 0 || q.property('arathnido:skins') == 1 || q.property('arathnido:skins') == 3 || q.property('arathnido:skins') == 7"},
						{"player.blue_venom.hability":"q.property('arathnido:skins') == 2"},
						{"player.ultimate_venom.hability":"q.property('arathnido:skins') == 4 || q.property('arathnido:skins') == 5"},
						{"player.venom_2099.hability":"q.property('arathnido:skins') == 6"},
						{"player.venom_snow.hability":"q.property('arathnido:skins') == 8"},
						{"player.antivenom.hability":"q.property('arathnido:skins') == 9"},
						{"player.venom.hability.move":"q.modified_move_speed > 0.1 && (q.property('arathnido:skins') == 0 || q.property('arathnido:skins') == 1 || q.property('arathnido:skins') == 3 || q.property('arathnido:skins') == 7)"}, 
						{"player.blue_venom.hability.move":"q.modified_move_speed > 0.1 && q.property('arathnido:skins') == 2"},
						{"player.venom_2099.hability.move":"q.modified_move_speed > 0.1 && q.property('arathnido:skins') == 6"}, 
