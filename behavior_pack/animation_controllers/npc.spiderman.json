{
	"format_version": "1.10.0",
	"animation_controllers": {
		"controller.animation.npc.spiderman.climb" : {
			"initial_state" : "default",
			"states" : {
				"default" : {
					"on_entry" : [ "/event entity @s spiderman:climb.on" ],
					"transitions" : [
						{
							"spiderman.climb" : "q.is_sitting"
						}
					]
				},
				"spiderman.climb" : {
					"on_entry" : [ "/event entity @s spiderman:climb.off" ],
					"transitions" : [
						{
							"default" : "!q.is_sitting"
						}
					]
				}
			}
		},
		"controller.animation.npc.spiderman.ia" : {
			"initial_state" : "default",
			"states" : {
				"default" : {
					"transitions" : [
						{
							"spiderman.ia" : "q.has_target"
						}
					]
				},
				"spiderman.ia" : {
					"animations" : [ "ia" ],
					"transitions" : [
						{
							"default" : "!q.has_target"
						}
					]
				}
			}
		}
	}
}