{
  "format_version": "1.13.0",
  "minecraft:entity": {
    "description": {
      "identifier": "spidermanaddon:web_grabber_invoke",
      "is_spawnable": false,
      "is_summonable": true,
      "is_experimental": false
    },
	"component_groups": {
	  "minecraft:dont_eat": {
		"minecraft:instant_despawn": {
			"remove_child_entities": true
		}
	  }
