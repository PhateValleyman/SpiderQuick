      },
      "minecraft:fire_immune": true,
      "minecraft:knockback_resistance": {
        "value": 1.0
      },
	  "minecraft:timer": { "looping": true, "time": 1.85, "time_down_event": { "event": "minecraft:dont_eat" } },
      "minecraft:health": {
        "value": 10,
        "max": 10
      },
      "minecraft:hurt_on_condition": {
        "damage_conditions": [
          {
            "filters": { "test": "in_lava", "subject": "self", "operator": "==", "value": true },
            "cause": "lava",
            "damage_per_tick": 0
          }
        ]
      },
      "minecraft:nameable": {
      },
      "minecraft:persistent": {
      },
      "minecraft:physics": {
      },
      "minecraft:pushable": {
        "is_pushable": false,
        "is_pushable_by_piston": false
      }
    },

    "events": {
      "minecraft:dont_eat": {
        "add": {
          "component_groups": [
            "minecraft:dont_eat"
          ]
        }
      }
    }
  }
}
