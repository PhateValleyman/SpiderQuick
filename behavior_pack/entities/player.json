      "spiderman:web_shield": {
		"minecraft:damage_sensor": {
          "triggers": {
		    "cause": "all",
			"deals_damage": false,
            "on_damage": {
              "event": "spiderman:web_shield.off"
            }
          }
        }
	  },
		"spiderman:damage_sensor": {
		  "minecraft:damage_sensor": {
			"triggers": [
			  {
				"on_damage": {
				  "filters": {
					"all_of": [
					  {
						"test": "has_damage",
						"value": "fall"
					  }
					]
				  }
				},
				"deals_damage": false
			  },
				{
				  "on_damage": {
					"filters": {
					  "all_of": [
						{ "test": "has_damage", "operator": "!=", "value": "projectile" },
						{ "test": "has_tag", "operator": "==", "subject": "self", "value": "spiderman_punch_load" },
						{
						  "any_of": [
							{ "test": "has_tag", "operator": "==", "subject": "other", "value": "spiderman_now_punches" },
							{ "test": "has_tag", "operator": "==", "subject": "other", "value": "spiderman_punches1" },
							{ "test": "has_tag", "operator": "==", "subject": "other", "value": "spiderman_punches2" },
							{ "test": "has_tag", "operator": "==", "subject": "other", "value": "spiderman_punches3" },
							{ "test": "has_tag", "operator": "==", "subject": "other", "value": "spiderman_punches4" }
						  ]
						},
						{ "test": "is_family", "operator": "!=", "subject": "other", "value": "player" },
						{ "test": "is_family", "operator": "!=", "subject": "other", "value": "boss" }
					  ]
					}
				  },
				  "deals_damage": false
				}
			]
		  }
		},
	  "web_shooter:shoot": { "minecraft:spawn_entity": {"entities": [{"min_wait_time": 0,"max_wait_time": 0,"single_use": true,"spawn_entity": "spidermanaddon:web_shooter_shoot","num_to_spawn": 1 }]}
