{
	"format_version": "1.16.100",
	"minecraft:entity": {
		"description": {
			"identifier": "spidermanaddon:shocker_shoot2",
			"runtime_identifier": "minecraft:snowball",
			"is_spawnable": false,
			"is_summonable": true,
			"is_experimental": false,
			"animations": {
				"shoot": "controller.animation.shocker_particle2"
			},
			"scripts": {
				"animate": [
					"shoot"
				]
			}
		},
		"components": {
			"minecraft:collision_box": {
				"width": 0.25,
				"height": 0.25
			},
         "minecraft:area_attack" : {
          "damage_range": 5,
          "damage_per_tick": 18.0,
          "cause": "contact",
          "entity_filter": {
            "any_of": [
              { "test": "is_family", "subject": "other", "value": "player" },
			  { "test": "is_family", "subject": "other", "value": "mob" }
            ]
          }
        },
			"minecraft:projectile": {
				"on_hit": {
					"definition_event": {
						"event_trigger": {
							"event": "hit",
							"target": "self"
						}
					},
					"impact_damage": {
						"damage": [
							16,
							16
						],
						"knockback": true,
						"destroy_on_hit": true,
						"semi_random_diff_damage": false,
						"filter": "query.has_any_family(\"bullet\")"
					}
				},
				"hit_sound": "gun.impact",
				"power": 2.8,
				"gravity": 0.001,
				"anchor": 1,
				"destroy_on_hurt": true,
				"uncertaintyBase": 1.9,
				"should_bounce": false,
				"inertia": 1,
				"offset": [
					0,
					0.5,
					0
				],
				"multiple_targets": true
			},
			"minecraft:physics": {},
			"minecraft:pushable": {
				"is_pushable": false,
				"is_pushable_by_piston": false
			},
			"minecraft:navigation.float": {},
			"minecraft:type_family": {
				"family": [
					"bullet"
				]
			},
			"minecraft:timer": {
			  "looping": true,
			  "time": 1.5,
			  "randomInterval": false,
			  "time_down_event": {
				"event": "hit"
				}
			}
		},
		"component_groups": {
			"hit": {
				"minecraft:instant_despawn": {
					"remove_child_entities": true
				}
			},
			"timer_hit": {
			"minecraft:timer": {
			  "looping": true,
			  "time": 1.25,
			  "randomInterval": false,
			  "time_down_event": {
				"event": "hit"
			  }
		}
			}
		},
		"events": {
			"timer_hit": {
				"sequence": [
					{
						"add": {
							"component_groups": [
								"timer_hit"
							]
						}
					}
				]
			},
			"hit": {
				"sequence": [
					{
						"add": {
							"component_groups": [
								"hit"
							]
						}
					}
				]
			}
		}
