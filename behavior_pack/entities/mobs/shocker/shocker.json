{
  "format_version": "1.13.0",
  "minecraft:entity": {
    "description": {
      "identifier": "spidermanaddon:shocker",
      "is_spawnable": true,

      "is_summonable": true,

      "is_experimental": false,
      "properties": {
		  "nido:scan":{ "type": "bool", "default": true, "client_sync": true }
      },
			"animations": {
				"enemy.sense.pistol": "animation.shocker.sense",
				"enemy.sense.pistol.c": "controller.animation.enemy.sense.pistol"
			},
			"scripts": {
				"animate": [
					"enemy.sense.pistol.c",
					"enemy.sense.pistol"
				]
			}
    },
    "component_groups": {
      "shocker:normal_shoot": {
      "minecraft:shooter": {
        "def": "spidermanaddon:shocker_shoot"
      },
        "minecraft:mark_variant": {
          "value": 1
        },
		"minecraft:timer": {
			  "looping": false,
			  "time": 2.5,
			  "time_down_event": {
				"event": "spiderman:shoot_pistol_off"
			}
		},
      "minecraft:behavior.ranged_attack": {
        "priority": 0,
		"burst_shots": 5,
		"burst_interval": 0.25,
        "attack_interval_min": 0.0,
        "attack_interval_max": 1.25,
        "attack_radius": 16.0
      }
	  },
      "shocker:full_shoot": {
		"minecraft:timer": {
			  "looping": false,
			  "time": 3.5,
			  "time_down_event": {
				"event": "spiderman:shoot_fusil_off"
			}
		},
      "minecraft:shooter": {
        "def": "spidermanaddon:shocker_shoot2"
      },
      "minecraft:behavior.ranged_attack": {
        "priority": 0,
		"burst_shots": 1,
		"burst_interval": 0.1,
        "attack_interval_min": 1.15,
        "attack_interval_max": 1.75,
        "attack_radius": 24.0
      },
        "minecraft:mark_variant": {
          "value": 2
        }
	  },
      "shocker:default": {
        "minecraft:mark_variant": {
          "value": 0
        }
	  }
	},
    "components": {
      "minecraft:type_family": {
        "family": [ "mob", "shocker", "monster" ]
      },
        "minecraft:experience_reward": {
          "on_bred": "Math.Random(100,500)",
          "on_death": "query.last_hit_by_player ? Math.Random(500,900) : 0"
        },
      "minecraft:loot": {
        "table": "loot_tables/shocker.json"
      },
      "minecraft:behavior.random_stroll": {
        "priority": 8,
        "speed_multiplier": 1.0
      },
      "minecraft:behavior.hurt_by_target": {
        "priority": 1
      },
      "minecraft:behavior.nearest_attackable_target": {
        "priority": 2,
        "within_radius": 16,
        "reselect_targets": true,
        "entity_types": [
          {
            "filters": {
              "any_of": [
                { "test": "is_family", "subject": "other", "value": "player" }
              ]
            },
            "max_dist": 16
          }
        ],
        "must_see": true,
        "must_see_forget_duration": 17.0
      },
      "minecraft:health": {
        "value": 200,
        "max": 200
      },
      "minecraft:behavior.look_at_player": {
        "priority": 6,
        "target_distance": 6.0,
        "probability": 0.02
      },
      "minecraft:jump.static": {
      },
      "minecraft:navigation.walk": {
      },
      "minecraft:movement.basic": {
      },
      "minecraft:movement": {
        "value": 0.25,
        "max": 0.25
      },
		"minecraft:pushable": {
			"is_pushable": true,
			"is_pushable_by_piston": true
		},

      "minecraft:scale": {
        "value": 1.05
      },      
	  "minecraft:physics": {
		"has_gravity":true,
		"has_collision":true
      },
      "minecraft:collision_box": {
          "width": 0.6,
          "height": 1.8
      }
    },
        
	"events": {
		"minecraft:entity_spawned": {
            "add": {
              "component_groups": [
                "shocker:default"
              ]
            }
      },
	 "shocker:shoot_on": {
        "randomize": [
          {
            "weight": 50,
            "add": {
              "component_groups": [
                "shocker:normal_shoot"
              ]
            },
            "remove": {
              "component_groups": [
                "shocker:default"
              ]
            }
          },
          {
            "weight": 50,
            "add": {
              "component_groups": [
                "shocker:full_shoot"
              ]
            },
            "remove": {
              "component_groups": [
                "shocker:default"
              ]
            },
          "queue_command": {
            "command": [
              "playsound spiderman_effects.shocker_shot_ultra @a[r=25] ~ ~ ~"
            ]
          }
          }
        ]
      },
      "nido:scan": { "set_property":{ "nido:scan": false }, "queue_command": { "command": [ "tag @s add nido_scan" ] }
      },
      "nido:scan.off": { "set_property":{ "nido:scan": true }, "queue_command": { "command": [ "tag @s remove nido_scan" ] }
      },
	 "shocker:shoot_off": {
	   "remove": {
            "component_groups": [
              "shocker:full_shoot",
			  "shocker:normal_shoot"
            ]
         },
	   "add": {
            "component_groups": [
              "shocker:default"
            ]
         }
      }
	}
  }
}