{
  "format_version": "1.20.80",
  "minecraft:entity": {
    "description": {
      "identifier": "spidermanaddon:scorpion",
      "is_spawnable": true,
      "is_summonable": true,
      "is_experimental": false,
      "properties": {
        "nido:scan": {
          "type": "bool",
          "default": true,
          "client_sync": true
        },
        "spidermanaddon:scorpion_state": {
          "type": "enum",
          "values": [
            "default",
            "tail_attack",
            "tail_attack_spin",
            "jump_attack",
            "jump_attack_end",
            "hide",
            "death"
          ],
          "default": "default",
          "client_sync": true
        }
      }
    },
    "component_groups": {
      "spidermanaddon:death_mode": {
        "minecraft:movement": {
          "value": 0
        },
        "minecraft:knockback_resistance": {
          "value": 1
        },
        "minecraft:damage_sensor": {
          "triggers": {
            "cause": "all",
            "deals_damage": false
          }
        },
        "minecraft:timer": {
          "looping": true,
          "time": 5,
          "time_down_event": {
            "event": "spidermanaddon:death_destroy",
            "target": "self"
          }
        }
      },
      "spidermanaddon:default_ai": {
        "minecraft:behavior.look_at_player": {
          "priority": 7,
          "look_distance": 12
        },
        "minecraft:behavior.random_look_around": {
          "priority": 8
        },
        "minecraft:movement": {
          "value": 0.3
        },
        "minecraft:behavior.melee_attack": {
          "priority": 2,
          "speed_multiplier": 1.2,
          "track_target": true,
          "reach_multiplier": 1.5
        },
        "minecraft:behavior.random_stroll": {
          "priority": 6,
          "speed_multiplier": 0.65
        }
      },
      "spidermanaddon:skill_ai": {
        "minecraft:behavior.look_at_player": {
          "priority": 7,
          "look_distance": 12
        },
        "minecraft:behavior.random_look_around": {
          "priority": 8
        },
        "minecraft:movement": {
          "value": 0
        }
      },
      "spidermanaddon:hide_ai": {
        "minecraft:behavior.look_at_player": {
          "priority": 7,
          "look_distance": 12
        },
        "minecraft:behavior.random_look_around": {
          "priority": 8
        },
        "minecraft:movement": {
          "value": 0.42
        },
        "minecraft:behavior.melee_attack": {
          "priority": 2,
          "speed_multiplier": 1.45,
          "track_target": true,
          "reach_multiplier": 1.8
        }
      }
    },
    "components": {
      "minecraft:type_family": {
        "family": [
          "monster",
          "mob",
          "boss",
          "scorpion"
        ]
      },
      "minecraft:boss": {
        "name": "Scorpion",
        "hud_range": 64,
        "should_darken_sky": false
      },
      "minecraft:experience_reward": {
        "on_death": "query.last_hit_by_player ? Math.Random(120,220) : 0"
      },
      "minecraft:loot": {
        "table": "loot_tables/entities/scorpion.json"
      },
      "minecraft:health": {
        "value": 1600,
        "max": 1600
      },
      "minecraft:attack": {
        "damage": 5
      },
      "minecraft:collision_box": {
        "width": 0.8,
        "height": 2
      },
      "minecraft:physics": {},
      "minecraft:pushable": {
        "is_pushable": true,
        "is_pushable_by_piston": true
      },
      "minecraft:knockback_resistance": {
        "value": 0.65
      },
      "minecraft:jump.static": {},
      "minecraft:navigation.walk": {
        "can_path_over_water": false,
        "avoid_water": true,
        "can_pass_doors": true,
        "can_open_doors": true
      },
      "minecraft:movement.basic": {},
      "minecraft:behavior.float": {
        "priority": 0
      },
      "minecraft:behavior.nearest_attackable_target": {
        "priority": 3,
        "must_see": true,
        "reselect_targets": true,
        "within_radius": 40,
        "entity_types": [
          {
            "filters": {
              "test": "is_family",
              "subject": "other",
              "value": "player"
            },
            "max_dist": 40
          }
        ]
      },
      "minecraft:damage_sensor": {
        "triggers": [
          {
            "on_damage": {
              "filters": {
                "test": "has_damage",
                "value": "fall"
              }
            },
            "deals_damage": false
          },
          {
            "on_damage": {
              "filters": {
                "all_of": [
                  {
                    "test": "has_damage",
                    "subject": "self",
                    "operator": "==",
                    "value": "fatal"
                  },
                  {
                    "test": "has_damage",
                    "subject": "self",
                    "operator": "!=",
                    "value": "void"
                  }
                ]
              },
              "event": "spidermanaddon:death_start",
              "target": "self"
            },
            "deals_damage": false
          }
        ]
      }
    },
    "events": {
      "minecraft:entity_spawned": {
        "add": {
          "component_groups": [
            "spidermanaddon:default_ai"
          ]
        },
        "set_property": {
          "spidermanaddon:scorpion_state": "default"
        }
      },
      "spidermanaddon:death_start": {
        "remove": {
          "component_groups": [
            "spidermanaddon:default_ai",
            "spidermanaddon:no_target_ai",
            "spidermanaddon:skill_ai",
            "spidermanaddon:hide_ai"
          ]
        },
        "add": {
          "component_groups": [
            "spidermanaddon:death_mode"
          ]
        },
        "set_property": {
          "spidermanaddon:scorpion_state": "death"
        },
        "queue_command": {
          "target": "self",
          "command": [
            "effect @s instant_health 1 10 true",
            "effect @s resistance 6 255 true",
            "effect @s slowness 6 255 true"
          ]
        }
      },
      "spidermanaddon:death_destroy": {
        "queue_command": {
          "target": "self",
          "command": [
            "effect @s invisibility 6 0 true",
            "kill @s"
          ]
        }
      },
      "nido:scan": {
        "set_property": {
          "nido:scan": false
        },
        "queue_command": {
          "command": [
            "tag @s add nido_scan"
          ]
        }
      },
      "nido:scan.off": {
        "set_property": {
          "nido:scan": true
        },
        "queue_command": {
          "command": [
            "tag @s remove nido_scan"
          ]
        }
      },
      "spidermanaddon:skill_on": {
        "remove": {
          "component_groups": [
            "spidermanaddon:default_ai",
            "spidermanaddon:hide_ai"
          ]
        },
        "add": {
          "component_groups": [
            "spidermanaddon:skill_ai"
          ]
        }
      },
      "spidermanaddon:hide_on": {
        "remove": {
          "component_groups": [
            "spidermanaddon:default_ai",
            "spidermanaddon:skill_ai"
          ]
        },
        "add": {
          "component_groups": [
            "spidermanaddon:hide_ai"
          ]
        }
      },
      "spidermanaddon:skill_off": {
        "remove": {
          "component_groups": [
            "spidermanaddon:skill_ai",
            "spidermanaddon:hide_ai"
          ]
        },
        "add": {
          "component_groups": [
            "spidermanaddon:default_ai"
          ]
        },
        "set_property": {
          "spidermanaddon:scorpion_state": "default"
        }
      }
    }
  }
}
