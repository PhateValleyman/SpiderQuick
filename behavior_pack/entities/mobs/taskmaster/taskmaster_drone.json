{
  "format_version": "1.16.0",
  "minecraft:entity": {
    "description": {
      "identifier": "spidermanaddon:taskmaster_drone",
      "is_spawnable": true,
      "is_summonable": true,
      "is_experimental": false,
      "properties": {
        "nido:scan": {
          "type": "bool",
          "default": true,
          "client_sync": true
        }
      },
      "animations": {
        "hunters_drone": "controller.animation.hunters_drone"
      },
      "scripts": {
        "animate": [
          "hunters_drone"
        ]
      }
    },
    "component_groups": {},
    "components": {
      "minecraft:is_hidden_when_invisible": {},
      "minecraft:experience_reward": {
        "on_death": "query.last_hit_by_player ? 5 + (query.equipment_count * Math.Random(1,3)) : 0"
      },
      "minecraft:breathable": {
        "total_supply": 15,
        "suffocate_time": 0
      },
      "minecraft:fire_immune": {},
      "minecraft:nameable": {},
      "minecraft:health": {
        "value": 15,
        "max": 15
      },
      "minecraft:collision_box": {
        "width": 1,
        "height": 1
      },
      "minecraft:movement": {
        "value": 0.01
      },
      "minecraft:navigation.float": {
        "can_path_over_water": true
      },
      "minecraft:behavior.float_wander": {
        "priority": 2,
        "must_reach": true
      },
      "minecraft:can_fly": {},
      "minecraft:loot": {
        "table": "loot_tables/entities/hunters_robots.json"
      },
      "minecraft:shooter": {
        "def": "spidermanaddon:fusil_shoot"
      },
      "minecraft:type_family": {
        "family": [
          "hunters_drone",
          "monster",
          "mob"
        ]
      },
      "minecraft:damage_sensor": {
        "triggers": {
          "cause": "fall",
          "deals_damage": false
        }
      },
      "minecraft:jump.static": {},
      "minecraft:despawn": {
        "despawn_from_distance": {}
      },
      "minecraft:behavior.float": {
        "priority": 0
      },
      "minecraft:behavior.ranged_attack": {
        "priority": 4,
        "attack_interval_min": 3,
        "attack_interval_max": 5,
        "charge_charged_trigger": 0,
        "charge_shoot_trigger": 4,
        "attack_radius": 16,
        "burst_shots": 3,
        "burst_interval": 0.3
      },
      "minecraft:follow_range": {
        "value": 64,
        "max": 64
      },
      "minecraft:behavior.hurt_by_target": {
        "priority": 1
      },
      "minecraft:behavior.nearest_attackable_target": {
        "priority": 2,
        "must_see": true,
        "reselect_targets": true,
        "within_radius": 64,
        "must_see_forget_duration": 17,
        "entity_types": [
          {
            "filters": {
              "any_of": [
                {
                  "test": "is_family",
                  "subject": "other",
                  "value": "player"
                }
              ]
            },
            "max_dist": 42,
            "must_see": false
          }
        ]
      },
      "minecraft:physics": {},
      "minecraft:pushable": {
        "is_pushable": true,
        "is_pushable_by_piston": true
      },
      "minecraft:conditional_bandwidth_optimization": {}
    },
    "events": {
      "nido:scan": {
        "set_property": {
          "nido:scan": false
        },
        "queue_command": {
          "command": [
            "tag @s add nido_scan"
          ]
        }
      },
      "nido:scan.off": {
        "set_property": {
          "nido:scan": true
        },
        "queue_command": {
          "command": [
            "tag @s remove nido_scan"
          ]
        }
      }
    }
  }
}
