{
  "format_version": "1.13.0",
  "minecraft:entity": {
    "description": {
      "identifier": "spidermanaddon:symbiont",
      "is_spawnable": true,

      "is_summonable": true,

      "is_experimental": false
    },
    "component_groups": {
			"minecraft:symbiont": {
				"minecraft:instant_despawn": {
					"remove_child_entities": true
				}
			}
	},
    "components": {
        "minecraft:experience_reward": {
          "on_bred": "Math.Random(10,50)",
          "on_death": "query.last_hit_by_player ? Math.Random(5,30) : 0"
        },
        "minecraft:interact": {
          "interactions": [
            {
              "on_interact": {
               "filters": {
                  "all_of": [
                    { "test": "is_family", "subject" : "other", "value" :  "player"},
                    { "test": "has_equipment", "domain": "hand", "subject": "other", "value": "spidermanaddon:capsule"}
                  ]
                },
                "event": "minecraft:symbiont"
              },
			  "transform_to_item": "spidermanaddon:symbiote_capsule",
              "interact_text": "action.interact.armadura",
              "use_item": true,
              "play_sounds": "armor.equip_leather"
            }
          ]
        },
      "minecraft:type_family": {
        "family": [ "symbiont", "monster", "mob", "symbiotes" ]
      },
      "minecraft:health": {
        "value": 120,
        "max": 120
      },
      "minecraft:navigation.walk": {
      },
      "minecraft:movement.basic": {
      },
      "minecraft:behavior.random_stroll": {
        "priority": 6,
        "speed_multiplier": 0.8
      },
      "minecraft:movement": {
        "value": 0.15,
        "max": 0.15
      },
		"minecraft:pushable": {
			"is_pushable": true,
			"is_pushable_by_piston": true
		},

      "minecraft:scale": {
        "value": 1.15
      },      
      "minecraft:physics": {
      },
      "minecraft:collision_box": {
        "width": 0.5,
        "height": 0.5
      }
    },

    "events": {
      "minecraft:symbiont": {
        "add": {
          "component_groups": [
            "minecraft:symbiont"
          ]
        }
      }
	}
  }
}