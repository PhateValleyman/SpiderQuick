{
  "format_version": "1.13.0",
  "minecraft:entity": {
    "description": {
      "identifier": "spidermanaddon:symbiote_nests",
      "is_spawnable": true,

      "is_summonable": true,

      "is_experimental": false
    },
    "component_groups": {
			"death": {
				"minecraft:transformation": {
					"into": "spidermanaddon:symbiont"
				}
			},
		"destroy": {
			"minecraft:instant_despawn": {
				"remove_child_entities": true
			}
		}
	},
    "components": {
      "minecraft:despawn": {
        "despawn_from_distance": {}
      },
      "minecraft:loot": {
        "table": "loot_tables/blocks/symbiote_nests.json"
      },
      "minecraft:type_family": {
        "family": [ "symbiote_nests", "monster", "symbiotes" ]
      },
      "minecraft:health": {
        "value": 80,
        "max": 80
      },
		  "minecraft:behavior.summon_entity": {
			"priority": 2,
			"summon_choices": [
			  {
				"min_activation_range": 0.0,
				"max_activation_range": 32.0,
				"cooldown_time": 12.5,
				"weight": 1,
				"cast_duration": 2.0,
				"particle_color": "#FF664D59",
				"start_sound_event": "cast.spell",
				"sequence": [
				  {
					"shape": "circle",
					"target": "self",
					"base_delay": 1.0,
					"delay_per_summon": 0.0,
					"num_entities_spawned": 3,
					"entity_type": "spidermanaddon:symbiotes",
					"size": 3,
					"sound_event": "prepare.attack",
					"summon_event": "minecraft:entity_spawned"
				  }
				]
			  }
			]
		  },
      "minecraft:navigation.walk": {
      },
      "minecraft:movement.basic": {
      },
		"minecraft:behavior.nearest_attackable_target": {
        "priority": 2,
        "must_see": true,
        "reselect_targets": true,
        "within_radius": 32.0,
        "must_see_forget_duration": 17.0,
        "entity_types": [
          {
            "filters": {
              "any_of": [
                { "test": "is_family", "subject": "other", "value": "player" },
                { "test": "is_family", "subject": "other", "value": "snowgolem" },
                { "test": "is_family", "subject": "other", "value": "irongolem" }
              ]
            },
            "max_dist": 24,
            "must_see": false
          },
          {
            "filters": {
              "any_of": [
                { "test": "is_family", "subject": "other", "value": "villager" },
                { "test": "is_family", "subject": "other", "value": "wandering_trader" }
              ]
            },
            "max_dist": 16,
            "must_see": false
          }
        ]
      },
      "minecraft:movement": {
        "value": 0,
        "max": 0
      },
		"minecraft:on_death": {
			"event": "death",
			"target": "self"
		},
      "minecraft:knockback_resistance": {
        "value": 100,
        "max": 100
      },
	  "minecraft:fire_immune": {},
			"minecraft:damage_sensor": {
			  "triggers": {
				"on_damage": {
				  "filters": {
					"all_of": [
					  {
						"test": "has_damage",
						"operator": "!=",
						"value": "contact"
					  }
					]
				  },
				  "event": "spidermanaddon:blood",
				  "target": "self"
				}
			}
		},
      "minecraft:scale": {
        "value": 1.0
      },
      "minecraft:physics": {
      },
	  "minecraft:pushable": {
		"is_pushable": false,
		"is_pushable_by_piston": false
	  },
      "minecraft:collision_box": {
        "width": 1.25,
        "height": 2.25
      }
    },
        
	"events": {
      "destroy": {
        "add": {
          "component_groups": [
            "destroy"
          ]
        }
      },
      "spidermanaddon:blood": {
	    "queue_command": {
          "command": [
			"particle spidermanaddon:symbiote_splash ~ ~1.25 ~",
			"particle spidermanaddon:venom_particle ~ ~1.25 ~",
			"particle spidermanaddon:venom_particle ~ ~2 ~",
			"particle spidermanaddon:symbiote_splash ~ ~1.85 ~"
          ]
	    }
      },
      "death": {
        "add": {
          "component_groups": [
            "death"
          ]
        },
	    "queue_command": {
          "command": [
			"particle spidermanaddon:symbiote_splash ~ ~1.25 ~",
			"particle spidermanaddon:venom_particle ~ ~1.25 ~",
			"particle spidermanaddon:venom_particle ~ ~2 ~",
			"particle spidermanaddon:symbiote_splash ~ ~1.85 ~",
			"particle spidermanaddon:venom_particle ~ ~0.5 ~",
			"summon xp_orb",
			"summon xp_orb",
			"summon xp_orb",
			"summon xp_orb",
			"summon xp_orb"
          ]
	    }
      }
	}
  }
}