{
  "format_version": "1.13.0",
  "minecraft:entity": {
    "description": {
      "identifier": "spidermanaddon:robot_dog_pet",
      "is_spawnable": false,
      "is_summonable": true,
      "is_experimental": false,
      "scripts": {
        "animate": [ 
			"robot_dog_IA.c"
		]
      },
      "animations": {
		  "robot_dog_IA.c": "controller.animation.robot_dog.ia",
		  "robot_dog_IA": "animation.robot_dog.ia"
      }
    },

    "component_groups": {
      "robot_dog:default": {
        "minecraft:mark_variant": {
          "value": 0
        }
	  },
      "robot_dog:jump": {
        "minecraft:mark_variant": {
          "value": 1
        }
	  },
      "minecraft:robot_dog_pet_wild": {
        "minecraft:tameable": {
          "probability": 1.0,
          "tame_items": "spidermanaddon:robot_dog_pet_plans",
          "tame_event": {
            "event": "minecraft:on_tame",
            "target": "self"
          }
        }
      },
      "minecraft:robot_dog_pet_tame": {
      "minecraft:behavior.melee_attack": {
        "priority": 1,
        "speed_multiplier": 1.4,
        "track_target": false
      },
      "minecraft:attack": {
        "damage": 9,
		"effect_duration": 3.0,
		"effect_name": "slowness"
	  },
      "minecraft:movement": {
        "value": 0.35
      },
      "minecraft:behavior.look_at_player": {
        "priority": 6,
        "target_distance": 6.0,
        "probability": 0.02
      },
        "minecraft:is_tamed": {
        },
        "minecraft:health": {
          "value": 100,
          "max": 100
        },
        "minecraft:behavior.follow_owner": {
          "priority": 6,
          "speed_multiplier": 1.0,
          "start_distance": 10,
          "stop_distance": 2
        },
        "minecraft:behavior.breed": {
          "priority": 7
        },

        "minecraft:behavior.owner_hurt_by_target": {
          "priority": 1
        },
        "minecraft:behavior.owner_hurt_target": {
          "priority": 2
        },

        "minecraft:sittable": {
        },

        "minecraft:leashable": {
          "soft_distance": 4.0,
          "hard_distance": 6.0,
          "max_distance": 10.0,
          "on_leash": {
            "event": "minecraft:on_leash",
            "target": "self"
          },
          "on_unleash": {
            "event": "minecraft:on_unleash",
            "target": "self"
          }
        }
      }
    },


    "components": {
      "minecraft:nameable": {
      },
      "minecraft:type_family": {
        "family": [ "robot_dog", "mob" ]
      },
        "minecraft:scale": {
          "value": 1.5
        },
      "minecraft:breathable": {
        "total_supply": 15,
        "suffocate_time": 0
      },
      "minecraft:collision_box": {
        "width": 0.75,
        "height": 1.0
      },
      "minecraft:health": {
        "value": 25,
        "max": 25
      },
      "minecraft:hurt_on_condition": {
        "damage_conditions": [
          {
            "filters": { "test": "in_lava", "subject": "self", "operator": "==", "value": true },
            "cause": "lava",
            "damage_per_tick": 4
          }
        ]
      },
      "minecraft:movement": {
        "value": 0.0
      },
      "minecraft:navigation.walk": {
        "can_float": true,
        "avoid_water": true,
        "avoid_damage_blocks": true
      },
      "minecraft:movement.basic": {
      },
      "minecraft:jump.static": {
      },
      "minecraft:can_climb": {
      },
      "minecraft:healable": {
        "items": [
          {
            "item": "redstone",
            "heal_amount": 3
          }
        ]
      },
      "minecraft:behavior.float": {
        "priority": 0
      },
      "minecraft:behavior.mount_pathing": {
        "priority": 1,
        "speed_multiplier": 1.25,
        "target_dist": 0,
        "track_target": true
      },
      "minecraft:behavior.stay_while_sitting": {
        "priority": 3
      },
      "minecraft:behavior.leap_at_target": {
        "priority": 4,
        "target_dist": 0.4
      },
      "minecraft:behavior.random_stroll": {
        "priority": 8,
        "speed_multiplier": 1.0
      },
      "minecraft:behavior.beg": {
        "priority": 9,
        "look_distance": 8,
        "look_time": [ 2, 4 ],
        "items": [ "bone", "porkchop", "cooked_porkchop", "chicken", "cooked_chicken", 
                   "beef", "cooked_beef", "rotten_flesh", "muttonraw", "muttoncooked", "rabbit", "cooked_rabbit" ]
      },

      "minecraft:behavior.hurt_by_target": {
        "priority": 3
      },
	    "minecraft:physics": {
      },
      "minecraft:pushable": {
        "is_pushable": true,
        "is_pushable_by_piston": true
      }
    },


    "events": {
      "minecraft:entity_spawned": {
        "add": {
          "component_groups": [
            "minecraft:robot_dog_pet_wild"
          ]
        }
      },
      "minecraft:on_tame": {
        "remove": {
          "component_groups": [
            "minecraft:robot_dog_pet_wild"
          ]
        },
        "add": {
          "component_groups": [
            "minecraft:robot_dog_pet_tame"
          ]
        }
      },
      "minecraft:default": {
        "add": {
          "component_groups": [
            "robot_dog:default"
          ]
        },
        "remove": {
          "component_groups": [
            "robot_dog:jump"
          ]
        }
      },
      "minecraft:hability_active": {
        "remove": {
          "component_groups": [
            "robot_dog:default"
          ]
        },
        "add": {
          "component_groups": [
            "robot_dog:jump"
          ]
        }
      }
    }
  }
}
