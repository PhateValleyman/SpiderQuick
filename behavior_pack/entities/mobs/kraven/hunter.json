{
  "format_version": "1.8.0",
  "minecraft:entity": {
	"description": {
      "identifier": "spidermanaddon:hunter",
         "is_spawnable":true,
         "is_summonable":true,
         "is_experimental":false,
      "properties": {
		  "nido:scan":{ "type": "bool", "default": true, "client_sync": true }
      },
      "scripts": {
        "animate": [ 
			"hunter_IA.c"
		]
      },
      "animations": {
		  "hunter_IA.c": "controller.animation.hunter.ia",
		  "hunter_IA": "animation.hunter.ia"
      }
    },
    "components": {
      "minecraft:knockback_resistance": {
        "value": 0.25
      },
        "minecraft:experience_reward": {
          "on_bred": "Math.Random(10,50)",
          "on_death": "query.last_hit_by_player ? Math.Random(10,20) : 0"
        },
      "minecraft:fire_immune": true,
      "minecraft:burns_in_daylight": false,
      "minecraft:type_family": {
        "family": [ "hunter" ]
      },
      "minecraft:breathable": {
        "totalSupply": 15,
        "suffocateTime": 0
      },
    "minecraft:despawn": {
      "despawn_from_distance": {}
     },
      "minecraft:collision_box": {
        "width": 0.75,
        "height": 1.9
      },
      "minecraft:loot": {
        "table": "loot_tables/entities/hunter.json"
      },
      "minecraft:health": {
        "value": 45,
		"max": 45
      },
      "minecraft:attack": {
        "damage": 8
	  },
        "minecraft:scale": {
          "value": 1.05
        },
      "minecraft:movement": {
        "value": {
          "range_min": 0.25, 
          "range_max": 0.325
        }
      },
      "minecraft:navigation.walk": {
        "can_float": true,
        "avoid_water": true,
        "avoid_damage_blocks": true
      },
      "minecraft:movement.basic": {
        
      },
      "minecraft:jump.static": {
      },
      "minecraft:nameable": {
      },
      "minecraft:balloonable": {
      },
      "minecraft:behavior.float": {
        "priority": 0
      },
      "minecraft:behavior.break_door": {
        "priority": 1
      },
      "minecraft:behavior.move_towards_restriction": {
        "priority": 4,
        "speed_multiplier": 1
      },
      "minecraft:behavior.random_stroll": {
        "priority": 6,
        "speed_multiplier": 0.7
      },
      "minecraft:behavior.look_at_player": {
        "priority": 7,
        "look_distance": 6.0,
        "probability": 0.02
      },
      "minecraft:behavior.random_look_around": {
        "priority": 8
      },
      "minecraft:behavior.hurt_by_target": {
        "priority": 1
      },
      "minecraft:behavior.nearest_attackable_target": {
        "priority": 1,
        "within_radius": 7.5,
        "entity_types": [
          {
            "filters": { "other_with_families": [ "player" ] },
            "max_dist": 12.5
          }
        ]
      },
	    "minecraft:physics": {
      }
    },
    "component_groups": {
      "hunter:variant0": {
        "minecraft:variant": {
          "value": 0
        }
	  },
      "hunter:variant1": {
        "minecraft:variant": {
          "value": 1
        }
	  },
      "hunter:variant2": {
        "minecraft:variant": {
          "value": 2
        }
	  },
      "hunter:variant3": {
        "minecraft:variant": {
          "value": 3
        }
	  },
      "hunter:default": {
      "minecraft:behavior.melee_attack": {
        "priority": 1,
        "speed_multiplier": 1.4,
        "track_target": false
      },
      "minecraft:attack": {
        "damage": 12
	  },
        "minecraft:mark_variant": {
          "value": 0
        }
	  },
      "hunter:jump": {
        "minecraft:mark_variant": {
          "value": 1
        }
	  },
      "hunter:attack": {
	   "minecraft:area_attack" : {
          "damage_range": 3.5,
          "damage_per_tick": 15.0,
          "cause": "contact",
			"entity_filter": {
				"any_of": [
					{ "test": "is_family", "subject": "other", "operator": "!=", "value": "hunter" },
					{ "test": "is_family", "subject": "other", "operator": "==", "value": "animal" },
					{ "test": "is_family", "subject": "other", "operator": "==", "value": "monster" },
					{ "test": "is_family", "subject": "other", "operator": "==", "value": "player" }
				]    
			}
        }
	  },
      "minecraft:hunter_angry": {
        "minecraft:angry": {
          "duration": 25,
          "broadcast_anger": true,
          "broadcast_range": 20,
          "calm_event": {
            "event": "minecraft:on_calm",
            "target": "self"
          }
        }
      },
      "minecraft:hunter_calm": {
        "minecraft:on_target_acquired": {
          "event": "minecraft:become_angry",
          "target": "self"
        }
      }
	},
    "events": {
      "minecraft:entity_spawned": {
        "sequence": [
          {
            "randomize": [
              {
                "weight": 25,
                "remove": {
                },
                "add": {
                  "component_groups": [
                    "hunter:variant0"
                  ]
                }
              },
              {
                "weight": 25,
                "remove": {
                },
                "add": {
                  "component_groups": [
                    "hunter:variant1"
                  ]
                }
              },
              {
                "weight": 25,
                "remove": {
                },
                "add": {
                  "component_groups": [
                    "hunter:variant2"
                  ]
                }
              },
              {
                "weight": 25,
                "remove": {
                },
                "add": {
                  "component_groups": [
                    "hunter:variant3"
                  ]
                }
              }
            ]
          }
        ]
      },
      "minecraft:default": {
        "add": {
          "component_groups": [
            "hunter:default",
            "minecraft:hunter_calm"
          ]
        },
        "remove": {
          "component_groups": [
            "hunter:jump",
			"hunter:attack"
          ]
        }
      },
      "minecraft:hability_active": {
        "remove": {
          "component_groups": [
            "hunter:default"
          ]
        },
        "add": {
          "component_groups": [
            "hunter:jump"
          ]
        }
      },
      "hunter:attack": {
        "add": {
          "component_groups": [
            "hunter:attack"
          ]
        }
      },
      "minecraft:on_calm": {
        "remove": {
          "component_groups": [
            "minecraft:hunter_angry"
          ]
        },
        "add": {
          "component_groups": [
            "minecraft:hunter_calm"
          ]
        }
      },
      "nido:scan": { "set_property":{ "nido:scan": false }, "queue_command": { "command": [ "tag @s add nido_scan" ] }
      },
      "nido:scan.off": { "set_property":{ "nido:scan": true }, "queue_command": { "command": [ "tag @s remove nido_scan" ] }
      },
      "minecraft:become_angry": {
        "remove": {
          "component_groups": [
            "minecraft:hunter_calm"
          ]
        },
        "add": {
          "component_groups": [
            "minecraft:hunter_angry"
          ]
        }
      }
	}
  }
}