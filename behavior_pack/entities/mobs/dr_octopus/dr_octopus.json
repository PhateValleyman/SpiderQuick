{
  "format_version": "1.8.0",
  "minecraft:entity": {
	"description": {
      "identifier": "spidermanaddon:dr_octopus",
         "is_spawnable":true,
         "is_summonable":true,
         "is_experimental":false,
      "properties": {
		"nido:scan":{ "type": "bool", "default": true, "client_sync": true }
      },
      "scripts": {
        "animate": [ 
			"dr_octopus_IA.c",
			"dr_octopus_walk.c",
			"hability_1.c",
			"escudo.c",
			"hability_2.c",
			"idle",
			"on"
		]
      },
      "animations": {
		  "escudo.c": "controller.animation.dr_octopus.escudo",
		  "escudo": "animation.dr_octopus.escudo",
		  "dr_octopus_walk.c": "controller.animation.dr_octopus.walk",
		  "dr_octopus.walk": "animation.dr_octopus.walk",
		  "dr_octopus_IA.c": "controller.animation.dr_octopus.ia",
		  "dr_octopus_IA": "animation.dr_octopus.ia",
		  "hability_1.c": "controller.animation.dr_octopus.hability_1",
		  "hability_1": "animation.dr_octopus.hability_1",
		  
		  "hability_2.c": "controller.animation.dr_octopus.hability_2",
		  "hability_2": "animation.dr_octopus.hability_2",
		  "hability_2.off": "animation.dr_octopus.hability_2.off",
		  "hability_2.take": "animation.dr_octopus.hability_2.take",
		  "idle": "animation.dr_octopus.idle",
		  "on": "controller.animation.dr_octopus.on"
      }
    },
    "components": {

      "minecraft:knockback_resistance": {
        "value": 0.45
      },
        "minecraft:experience_reward": {
          "on_bred": "Math.Random(1000,5000)",
          "on_death": "query.last_hit_by_player ? Math.Random(1000,2000) : 0"
        },
      "minecraft:boss": {
        "should_darken_sky": false,
		"name":"Doctor Octopus",
        "hud_range": 100
      },
      "minecraft:fire_immune": false,
      "minecraft:burns_in_daylight": false,
      "minecraft:type_family": {
        "family": [ "dr_octopus" ]
      },
      "minecraft:breathable": {
        "totalSupply": 15,
        "suffocateTime": 0
      },
      "minecraft:collision_box": {
        "width": 0.75,
        "height": 2.75
      },
      "minecraft:loot": {
        "table": "loot_tables/entities/dr_octopus.json"
      },
      "minecraft:health": {
        "value": 1000,
		"max": 1000
      },
      "minecraft:attack": {
        "damage": 12
	  },
        "minecraft:scale": {
          "value": 1.1
        },
      "minecraft:movement": {
        "value": {
          "range_min": 0.25, 
          "range_max": 0.325
        }
      },
      "minecraft:navigation.climb": {
        "can_path_over_water": true,
        "avoid_damage_blocks": true
      },
      "minecraft:movement.basic": {
        
      },
      "minecraft:jump.static": {
      },
      "minecraft:nameable": {
      },
      "minecraft:balloonable": {
      },
      "minecraft:behavior.float": {
        "priority": 0
      },
      "minecraft:behavior.break_door": {
        "priority": 1
      },
      "minecraft:behavior.move_towards_restriction": {
        "priority": 4,
        "speed_multiplier": 1
      },
      "minecraft:behavior.random_stroll": {
        "priority": 6,
        "speed_multiplier": 0.7
      },
      "minecraft:behavior.look_at_player": {
        "priority": 7,
        "look_distance": 6.0,
        "probability": 0.02
      },
      "minecraft:behavior.random_look_around": {
        "priority": 8
      },
      "minecraft:behavior.hurt_by_target": {
        "priority": 1
      },
      "minecraft:behavior.nearest_attackable_target": {
        "priority": 2,
        "entity_types": [
          {
            "filters": {
              "test": "is_family",
              "subject": "other",
              "value": "player"
            },
            "max_dist": 28
          }
        ],
        "must_see": true
      },
	    "minecraft:physics": {
      }
    },
    "component_groups": {
      "dr_octopus:angry": {
        "minecraft:angry": {
          "duration": 25,
          "broadcast_anger": true,
          "broadcast_range": 20,
          "calm_event": {
            "event": "dr_octopus:on_calm",
            "target": "self"
          }
        },
        "minecraft:on_target_acquired": {
        }
      },

      "dr_octopus:wild": {
        "minecraft:on_target_acquired": {
          "event": "dr_octopus:angry",
          "target": "self"
        }
      },
      "dr_octopus:campo_fuerza_off": {
	  "minecraft:damage_sensor": {
          "triggers": {
		    "cause": "fall",
			"deals_damage": false
        }
      },
        "minecraft:mark_variant": {
          "value": 0
        }
	  },
      "dr_octopus:campo_fuerza_v1": {
		"minecraft:timer": {
			  "looping": true,
			  "time": 12.0,
			  "time_down_event": {
				"event": "dr_octopus:campo_fuerza_off"
			}
		},
      "minecraft:damage_sensor": {
        "triggers": {
          "cause": "all",
          "deals_damage": false
        }
      },
        "minecraft:mark_variant": {
          "value": 1
        }
	  },
      "dr_octopus:electrocutado": {
	  "minecraft:damage_sensor": {
          "triggers": {
		    "cause": "fall",
			"deals_damage": false
        }
      },
		"minecraft:timer": {
			  "looping": true,
			  "time": 1.0,
			  "time_down_event": {
				"event": "dr_octopus:electrocutado_off"
			}
		},
        "minecraft:mark_variant": {
          "value": 11
        }
	  },
      "dr_octopus:attack_mode": {
      "minecraft:behavior.hurt_by_target": {
        "priority": 1
      },
      "minecraft:attack": {
        "damage": 9
	  },
      "minecraft:behavior.melee_attack": {
        "priority": 1,
        "speed_multiplier": 1.4,
        "track_target": false
	  }
	  },
      "dr_octopus:hability_off": {
        "minecraft:variant": {
          "value": 0
        }
	  },
      "dr_octopus:hability1": {
        "minecraft:variant": {
          "value": 1
        }
	  },
      "dr_octopus:hability2": {
      "minecraft:behavior.hurt_by_target": {
        "priority": 1
      },
        "minecraft:variant": {
          "value": 2
        }
	  }
	},
    "events": {
      "minecraft:entity_spawned": {
        "add": {
          "component_groups": [
            "dr_octopus:wild"
          ]
        }
      },
      "dr_octopus:hability_on": {
        "randomize": [
          {
            "weight": 50,
            "add": {
              "component_groups": [
                "dr_octopus:hability1"
              ]
            },
            "remove": {
              "component_groups": [
                "dr_octopus:attack_mode"
              ]
            }
          },
          {
            "weight": 50,
            "add": {
              "component_groups": [
                "dr_octopus:hability2"
              ]
            },
            "remove": {
              "component_groups": [
                "dr_octopus:attack_mode"
              ]
            }
          }
        ]
      },
      "dr_octopus:angry": {
        "remove": {
          "component_groups": [
            "dr_octopus:wild"
          ]
        },
        "add": {
          "component_groups": [
            "dr_octopus:angry"
          ]
        }
      },
      "dr_octopus:on_calm": {
        "remove": {
          "component_groups": [
            "dr_octopus:angry"
          ]
        },
        "add": {
          "component_groups": [
            "dr_octopus:wild"
          ]
        }
      },
      "dr_octopus:attack_mode": {
        "add": {
          "component_groups": [
            "dr_octopus:attack_mode",
			"dr_octopus:hability_off"
          ]
        },
        "remove": {
          "component_groups": [
            "dr_octopus:hability0",
			"dr_octopus:hability1",
			"dr_octopus:hability2",
			"dr_octopus:hability3"
          ]
        }
      },
      "dr_octopus:campo_fuerza": {
        "add": {
          "component_groups": [
            "dr_octopus:campo_fuerza_v1"
          ]
        },
        "remove": {
          "component_groups": [
            "dr_octopus:campo_fuerza_off"
          ]
        }
      },
      "dr_octopus:campo_fuerza_off": {
        "add": {
          "component_groups": [
            "dr_octopus:campo_fuerza_off"
          ]
        },
        "remove": {
          "component_groups": [
			"dr_octopus:campo_fuerza_v1"
          ]
        }
      },
      "dr_octopus:off": {
        "remove": {
          "component_groups": [
			"dr_octopus:attack_mode",
            "dr_octopus:hability0",
			"dr_octopus:hability1",
			"dr_octopus:hability2",
			"dr_octopus:hability3"
          ]
        },
		"add":{
			"component_groups":	[
				"dr_octopus:hability_off"
		   ]
		}
      },
      "minecraft:electrocutado": {
        "add": {
          "component_groups": [
            "dr_octopus:electrocutado",
			"dr_octopus:hability_off"
          ]
        },
        "remove": {
          "component_groups": [
			"dr_octopus:attack_mode",
			"dr_octopus:campo_fuerza_off",
			"dr_octopus:hability0",
			"dr_octopus:hability1",
			"dr_octopus:hability2",
			"dr_octopus:hability3"
          ]
        }
      },

      "nido:scan": { "set_property":{ "nido:scan": false }, "queue_command": { "command": [ "tag @s add nido_scan" ] }
      },
      "nido:scan.off": { "set_property":{ "nido:scan": true }, "queue_command": { "command": [ "tag @s remove nido_scan" ] }
      },
      "dr_octopus:electrocutado_off": {
        "remove": {
          "component_groups": [
            "dr_octopus:electrocutado"
          ]
        },
        "add": {
          "component_groups": [
			"dr_octopus:campo_fuerza_off",
			"dr_octopus:attack_mode"
          ]
        }
      }
	}
  }
}