{
  "format_version": "1.20.80",
  "minecraft:entity": {
    "description": {
      "identifier": "spidermanaddon:tarantula",
      "is_spawnable": true,
      "is_summonable": true,
      "is_experimental": false,
      "properties": {
        "nido:scan": {
          "type": "bool",
          "default": true,
          "client_sync": true
        },
        "spidermanaddon:tarantula_state": {
          "type": "enum",
          "values": [
            "default",
            "impulse_attack"
          ],
          "default": "default",
          "client_sync": true
        }
      }
    },
    "component_groups": {
      "spidermanaddon:default_ai": {
        "minecraft:movement": {
          "value": 0.31
        },
        "minecraft:behavior.melee_attack": {
          "priority": 2,
          "speed_multiplier": 1.25,
          "track_target": true,
          "reach_multiplier": 1.35
        },
        "minecraft:behavior.random_stroll": {
          "priority": 6,
          "speed_multiplier": 0.65
        }
      },
      "spidermanaddon:skill_ai": {
        "minecraft:movement": {
          "value": 0.0
        }
      }
    },
    "components": {
      "minecraft:type_family": {
        "family": [
          "monster",
          "mob",
          "tarantula"
        ]
      },
      "minecraft:health": {
        "value": 200,
        "max": 200
      },
      "minecraft:attack": {
        "damage": 4
      },
      "minecraft:collision_box": {
        "width": 0.65,
        "height": 1.9
      },
      "minecraft:physics": {},
      "minecraft:pushable": {
        "is_pushable": true,
        "is_pushable_by_piston": true
      },
      "minecraft:knockback_resistance": {
        "value": 0.35
      },
      "minecraft:jump.static": {},
      "minecraft:navigation.walk": {
        "can_path_over_water": false,
        "avoid_water": true,
        "can_pass_doors": true,
        "can_open_doors": true
      },
      "minecraft:movement.basic": {},
      "minecraft:behavior.float": {
        "priority": 0
      },
      "minecraft:behavior.hurt_by_target": {
        "priority": 1
      },
      "minecraft:behavior.nearest_attackable_target": {
        "priority": 3,
        "must_see": true,
        "must_see_forget_duration": 1.0,
        "reselect_targets": true,
        "within_radius": 26,
        "entity_types": [
          {
            "filters": {
              "test": "is_family",
              "subject": "other",
              "value": "player"
            },
            "max_dist": 26
          }
        ]
      },
      "minecraft:loot": {
        "table": "loot_tables/entities/tarantula.json"
      },
      "minecraft:behavior.look_at_player": {
        "priority": 7,
        "look_distance": 12
      },
      "minecraft:behavior.random_look_around": {
        "priority": 8
      },
      "minecraft:damage_sensor": {
        "triggers": [
          {
            "on_damage": {
              "filters": {
                "test": "has_damage",
                "value": "fall"
              }
            },
            "deals_damage": false
          }
        ]
      },
      "minecraft:experience_reward": {
        "on_death": "query.last_hit_by_player ? Math.Random(20,35) : 0"
      }
    },
    "events": {
      "minecraft:entity_spawned": {
        "add": {
          "component_groups": [
            "spidermanaddon:default_ai"
          ]
        },
        "set_property": {
          "spidermanaddon:tarantula_state": "default"
        }
      },
      "spidermanaddon:skill_on": {
        "remove": {
          "component_groups": [
            "spidermanaddon:default_ai"
          ]
        },
        "add": {
          "component_groups": [
            "spidermanaddon:skill_ai"
          ]
        }
      },
      "nido:scan": {
        "set_property": {
          "nido:scan": false
        },
        "queue_command": {
          "command": [
            "tag @s add nido_scan"
          ]
        }
      },
      "nido:scan.off": {
        "set_property": {
          "nido:scan": true
        },
        "queue_command": {
          "command": [
            "tag @s remove nido_scan"
          ]
        }
      },
      "spidermanaddon:skill_off": {
        "remove": {
          "component_groups": [
            "spidermanaddon:skill_ai"
          ]
        },
        "add": {
          "component_groups": [
            "spidermanaddon:default_ai"
          ]
        },
        "set_property": {
          "spidermanaddon:tarantula_state": "default"
        }
      }
    }
  }
}
