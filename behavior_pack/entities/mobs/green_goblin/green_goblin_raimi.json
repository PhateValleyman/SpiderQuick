	  // Volar y disparar laser
      "minecraft:hability_2": {
        "minecraft:variant": {
          "value": 2
        },
      "minecraft:navigation.float": {
        "can_path_over_water": true
      },
      "minecraft:behavior.float_wander": {
        "priority": 2,
        "must_reach": true
      },
      "minecraft:can_fly": {
      },
      "minecraft:movement": {
        "value": 0.0125
      },
      "minecraft:behavior.ranged_attack": {
        "priority": 0,
		"burst_shots": 1,
