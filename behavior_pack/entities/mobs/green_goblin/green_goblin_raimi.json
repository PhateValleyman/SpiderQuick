	"events": {
      "minecraft:entity_spawned": {
     "add": {
		"component_groups": [
			"minecraft:normal_goblin"
		  ]
		}
      },
	"green_goblin:off_habilities": {
     "add": {
		"component_groups": [
			"minecraft:normal_goblin"
		  ]
		},
     "remove": {
		"component_groups": [
			"minecraft:hability",
			"minecraft:hability_2",
			"minecraft:hability_3"
		  ]
		}
      },
      "nido:scan": { "set_property":{ "nido:scan": false }, "queue_command": { "command": [ "tag @s add nido_scan" ] }
      },
      "nido:scan.off": { "set_property":{ "nido:scan": true }, "queue_command": { "command": [ "tag @s remove nido_scan" ] }
      },
	"minecraft:hability_active": {
        "randomize": [
          {
            "weight": 33,
            "add": {
              "component_groups": [
                "minecraft:hability"
              ]
            },
            "remove": {
              "component_groups": [
                "minecraft:normal_goblin",
				"minecraft:hability_2",
				"minecraft:hability_3"
              ]
            }
          },
          {
            "weight": 33,
            "add": {
              "component_groups": [
                "minecraft:hability_2"
              ]
            },
            "remove": {
              "component_groups": [
                "minecraft:normal_goblin",
				"minecraft:hability",
				"minecraft:hability_3"
              ]
            }
          },
          {
            "weight": 33,
            "add": {
              "component_groups": [
                "minecraft:hability_3"
              ]
            },
            "remove": {
              "component_groups": [
                "minecraft:normal_goblin",
				"minecraft:hability",
				"minecraft:hability_2"
              ]
            }
          }
        ]
