{
  "format_version": "1.20.80",
  "minecraft:entity": {
    "description": {
      "identifier": "spidermanaddon:boomerang",
      "is_spawnable": true,
      "is_summonable": true,
      "is_experimental": false,
      "properties": {
        "nido:scan": {
          "type": "bool",
          "default": true,
          "client_sync": true
        },
        "spidermanaddon:boomerang_state": {
          "type": "enum",
          "values": [
            "default",
            "jump_attack",
            "shoot"
          ],
          "default": "default",
          "client_sync": true
        }
      }
    },
    "component_groups": {
      "spidermanaddon:default_ai": {
        "minecraft:movement": {
          "value": 0.28
        },
        "minecraft:behavior.ranged_attack": {
          "priority": 2,
          "attack_interval_min": 1.5,
          "attack_interval_max": 1.5,
          "attack_radius": 32.0,
          "speed_multiplier": 1.0
        },
        "minecraft:shooter": {
          "def": "spidermanaddon:boomerang_shoot"
        },
        "minecraft:behavior.random_stroll": {
          "priority": 6,
          "speed_multiplier": 0.65
        }
      },
      "spidermanaddon:skill_ai": {
        "minecraft:movement": {
          "value": 0.0
        }
      },
      "spidermanaddon:explosive_boomerang_ai": {
        "minecraft:movement": {
          "value": 0.05
        },
        "minecraft:behavior.look_at_player": {
          "priority": 2,
          "look_distance": 40
        },
        "minecraft:behavior.ranged_attack": {
          "priority": 1,
          "burst_shots": 1,
          "burst_interval": 0.1,
          "attack_interval_min": 0.25,
          "attack_interval_max": 0.25,
          "attack_radius": 40.0,
          "speed_multiplier": 1.0,
          "target_in_sight_time": 0.0
        },
        "minecraft:shooter": {
          "def": "spidermanaddon:boomerang_explosive_shoot"
        }
      }
    },
    "components": {
      "minecraft:type_family": {
        "family": [
          "monster",
          "mob",
          "boomerang"
        ]
      },
      "minecraft:loot": {
        "table": "loot_tables/entities/boomerang.json"
      },
      "minecraft:health": {
        "value": 300,
        "max": 300
      },
      "minecraft:attack": {
        "damage": 4
      },
      "minecraft:collision_box": {
        "width": 0.6,
        "height": 1.9
      },
      "minecraft:physics": {},
      "minecraft:pushable": {
        "is_pushable": true,
        "is_pushable_by_piston": true
      },
      "minecraft:jump.static": {},
      "minecraft:navigation.walk": {
        "can_path_over_water": false,
        "avoid_water": true,
        "can_pass_doors": true,
        "can_open_doors": true
      },
      "minecraft:movement.basic": {},
      "minecraft:behavior.float": {
        "priority": 0
      },
      "minecraft:behavior.hurt_by_target": {
        "priority": 1
      },
      "minecraft:behavior.nearest_attackable_target": {
        "priority": 3,
        "must_see": true,
        "must_see_forget_duration": 1.0,
        "reselect_targets": true,
        "within_radius": 28,
        "entity_types": [
          {
            "filters": {
              "test": "is_family",
              "subject": "other",
              "value": "player"
            },
            "max_dist": 28
          }
        ]
      },
      "minecraft:behavior.look_at_player": {
        "priority": 7,
        "look_distance": 10
      },
      "minecraft:behavior.random_look_around": {
        "priority": 8
      },
      "minecraft:experience_reward": {
        "on_death": "query.last_hit_by_player ? Math.Random(15,30) : 0"
      }
    },
    "events": {
      "minecraft:entity_spawned": {
        "add": {
          "component_groups": [
            "spidermanaddon:default_ai"
          ]
        },
        "set_property": {
          "spidermanaddon:boomerang_state": "default"
        }
      },
      "spidermanaddon:skill_on": {
        "remove": {
          "component_groups": [
            "spidermanaddon:default_ai",
            "spidermanaddon:explosive_boomerang_ai"
          ]
        },
        "add": {
          "component_groups": [
            "spidermanaddon:skill_ai"
          ]
        }
      },
      "spidermanaddon:skill_off": {
        "remove": {
          "component_groups": [
            "spidermanaddon:skill_ai",
            "spidermanaddon:explosive_boomerang_ai"
          ]
        },
        "add": {
          "component_groups": [
            "spidermanaddon:default_ai"
          ]
        },
        "set_property": {
          "spidermanaddon:boomerang_state": "default"
        }
      },
      "spidermanaddon:explosive_boomerang_on": {
        "remove": {
          "component_groups": [
            "spidermanaddon:default_ai",
            "spidermanaddon:skill_ai"
          ]
        },
        "add": {
          "component_groups": [
            "spidermanaddon:explosive_boomerang_ai"
          ]
        }
      },
      "nido:scan": {
        "set_property": {
          "nido:scan": false
        },
        "queue_command": {
          "command": [
            "tag @s add nido_scan"
          ]
        }
      },
      "nido:scan.off": {
        "set_property": {
          "nido:scan": true
        },
        "queue_command": {
          "command": [
            "tag @s remove nido_scan"
          ]
        }
      },
      "spidermanaddon:explosive_boomerang_off": {
        "remove": {
          "component_groups": [
            "spidermanaddon:explosive_boomerang_ai",
            "spidermanaddon:skill_ai"
          ]
        },
        "add": {
          "component_groups": [
            "spidermanaddon:default_ai"
          ]
        },
        "set_property": {
          "spidermanaddon:boomerang_state": "default"
        }
      }
    }
  }
}
