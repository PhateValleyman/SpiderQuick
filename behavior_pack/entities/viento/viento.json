{
  "format_version": "1.20.41",
  "minecraft:entity": {
    "description": {
      "identifier": "spidermanaddon:viento",
      "is_spawnable": true,

      "is_summonable": true,

      "is_experimental": false
    },
    "component_groups": {
		"spidermanaddon:destroy": {
			"minecraft:instant_despawn": {
				"remove_child_entities": true
			}
		}
	},
    "components": {
      "minecraft:type_family": {
        "family": [ "viento" ]
      },
			"minecraft:physics": {
				"has_collision": false,
				"has_gravity": false
			},
			"minecraft:pushable": {
				"is_pushable": false,
				"is_pushable_by_piston": true
			},
      "minecraft:health": {
        "value": 1,
        "max": 1
      },
      "minecraft:navigation.walk": {
      },
      "minecraft:movement.basic": {
      },
      "minecraft:despawn": {
        "despawn_from_distance": {}
      },
      "minecraft:movement": {
        "value": 0,
        "max": 0
      },
			"minecraft:fire_immune": {},
			"minecraft:persistent": {},
      "minecraft:damage_sensor": {
        "triggers": {
          "cause": "all",
          "deals_damage": false
        }
      },
      "minecraft:knockback_resistance": {
        "value": 100,
        "max": 100
      },

      "minecraft:scale": {
        "value": 7.5
      },
      "minecraft:collision_box": {
        "width": 0.1,
        "height": 0.1
      },
			"minecraft:timer": {
				  "looping": true,
				  "time": 60,
				  "time_down_event": {
					"event": "spidermanaddon:destroy"
				}
			}
    },

	"events": {
		  "spidermanaddon:destroy": {
			"add": {
			  "component_groups": [
				"spidermanaddon:destroy"
			  ]
			}
		},
		  "minecraft:entity_spawned": {
				"queue_command": {
					"command": [
								"execute unless entity @p[r=8] run tp ~ ~35 ~"
							]
						}
		  }
		}
	}
  }