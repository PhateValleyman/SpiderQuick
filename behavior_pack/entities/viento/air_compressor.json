{
  "format_version": "1.13.0",
  "minecraft:entity": {
    "description": {
      "identifier": "spidermanaddon:air_compressor",
      "is_spawnable": true,
      "is_summonable": true,
      "is_experimental": false,
      "scripts": {
        "animate": [ 
			"rotation"
		]
      },
      "animations": {
		"rotation": "controller.animation.block.rotation"
      }
    },
    "component_groups": {
		"spidermanaddon:death": {
				"minecraft:spawn_entity": {
					"entities": {
						"min_wait_time": 0,
						"max_wait_time": 0,
						"single_use": true,
						"num_to_spawn": 1,
						"spawn_item": "spidermanaddon:air_compressor_spawn_egg"
					}
				},
			"minecraft:timer": {
				  "looping": true,
				  "time": 0.1,
				  "time_down_event": {
					"event": "spidermanaddon:death_on"
				}
			}
		},
		"spidermanaddon:death_on": {
			"minecraft:instant_despawn": {
				"remove_child_entities": true
			}
		}
	},
    "components": {
			"minecraft:interact": {
				"interactions": [
					{
						"play_sounds": "armor.equip_generic",
						"on_interact": {
							"filters": {
								"all_of": [
									{ "test": "has_equipment", "subject": "other", "domain": "hand" },
									{ "test": "is_sneaking", "subject": "other"}
								]
							},
							"event": "spidermanaddon:death"
						}
					}
				]
			},
      "minecraft:loot": {
        "table": "loot_tables/blocks/air_compressor.json"
      },
      "minecraft:damage_sensor": {
        "triggers": {
          "cause": "all",
          "deals_damage": false
        }
      },
      "minecraft:type_family": {
        "family": [ "air_compressor" ]
      },
      "minecraft:health": {
        "value": 1,
        "max": 1
      },
      "minecraft:navigation.walk": {
      },
      "minecraft:movement.basic": {
      },
      "minecraft:movement": {
        "value": 0,
        "max": 0
      },
      "minecraft:knockback_resistance": {
        "value": 100,
        "max": 100
      },
      "minecraft:physics": {
      },

      "minecraft:scale": {
        "value": 1.7
      },
	"minecraft:collision_box": {
		"width": 2.0,
		"height": 1.3
	},
        "minecraft:is_collidable": {
        }
    },
	"events": {
		  "spidermanaddon:death": {
			"add": {
			  "component_groups": [
				"spidermanaddon:death"
			  ]
			}
		},
		  "spidermanaddon:death_on": {
			"add": {
			  "component_groups": [
				"spidermanaddon:death_on"
			  ]
			}
		  }
	}
  }
}