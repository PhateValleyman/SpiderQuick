{
  "format_version": "1.21.0",
  "minecraft:entity": {
    "description": {
      "identifier": "spidermanaddon:planeador",
      "is_spawnable": false,
      "is_summonable": true,
      "is_experimental": false,
      "scripts": {
        "animate": [ 
			{ "green_goblin_idle": "q.modified_move_speed > 0.1"}
		]
      },
      "animations": {
		"green_goblin_idle": "controller.animation.green_goblin.planeador"
      }
    },

    "component_groups": {
      "spidermanaddon:planeador_gravity": {
        "minecraft:physics": {
          "has_gravity": true
        }
      },

      "spidermanaddon:planeador_flying": {
        "minecraft:physics": {
          "has_gravity": false
        },

        "minecraft:movement.hover": {},

        "minecraft:input_air_controlled": {
          "strafe_speed_modifier": 2.0,
          "backwards_movement_modifier": 0.85
        },

        "minecraft:vertical_movement_action": {
          "vertical_velocity": 0.45
        }
      }
    },

    "components": {
      "minecraft:type_family": {
        "family": [
          "planeador",
          "fly_vehicle"
        ]
      },

      "minecraft:fire_immune": {},

      "minecraft:loot": {
        "table": "loot_tables/entities/planeador.json"
      },

      "minecraft:health": {
        "value": 100,
        "max": 100
      },

        "minecraft:flying_speed": {
          "value": 0.2
        },
      "minecraft:scale": {
        "value": 1.0
      },

      "minecraft:collision_box": {
        "width": 1.1,
        "height": 0.7
      },

      "minecraft:movement": {
        "value": 10
      },

      "minecraft:rideable": {
        "seat_count": 1,
        "controlling_seat": 0,
        "family_types": [
          "player"
        ],
        "interact_text": "action.interact.ride.horse",
        "pull_in_entities": true,
        "seats": [
          {
            "position": [0.0, 0.65, 0.0],
            "min_rider_count": 0,
            "max_rider_count": 1
          }
        ]
      },

      "minecraft:behavior.player_ride_tamed": {
        "priority": 0
      },

      "minecraft:is_tamed": {},

      "minecraft:damage_sensor": {
        "triggers": [
          {
            "cause": "fall",
            "deals_damage": false
          }
        ]
      },

      "minecraft:pushable": {
        "is_pushable": true,
        "is_pushable_by_piston": true
      },

      "minecraft:physics": {
        "has_gravity": true
      }
    },

    "events": {
      "minecraft:entity_spawned": {
        "add": {
          "component_groups": [
            "spidermanaddon:planeador_gravity"
          ]
        }
      },

      "spidermanaddon:start_flying": {
        "remove": {
          "component_groups": [
            "spidermanaddon:planeador_gravity"
          ]
        },
        "add": {
          "component_groups": [
            "spidermanaddon:planeador_flying"
          ]
        }
      },

      "spidermanaddon:stop_flying": {
        "remove": {
          "component_groups": [
            "spidermanaddon:planeador_flying"
          ]
        },
        "add": {
          "component_groups": [
            "spidermanaddon:planeador_gravity"
          ]
        }
      }
    }
  }
}